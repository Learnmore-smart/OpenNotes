<Page x:Class="Caelum.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Caelum.Pages"
      xmlns:controls="clr-namespace:Caelum.Controls"
      Background="{DynamicResource ThemeWorkspaceBrush}"
      AllowDrop="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="InvisibleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectionActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectionDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeDangerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeDangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AddTileTemplate">
            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="AddTile_Click" VerticalAlignment="Top"
                    MouseEnter="TileScale_MouseEnter" MouseLeave="TileScale_MouseLeave">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="AddTileContainer" Width="160" Background="Transparent" Margin="20,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="AddTileGrid" Grid.Row="0" Width="120" Height="160" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Viewbox Stretch="Uniform" MaxWidth="90" MaxHeight="120" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="90" Height="120">
                                        <Rectangle x:Name="BgRect" Fill="Transparent" RadiusX="5" RadiusY="5"/>
                                        <Rectangle Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="2" StrokeDashArray="6,4" RadiusX="5" RadiusY="5"/>
                                        <controls:LucideIcon Kind="Plus" Width="40" Height="40" Stroke="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FolderTileTemplate">
            <Border x:Name="FolderTileBorder" Margin="20,12" Background="Transparent" CornerRadius="10" Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Width="160"
                      Background="Transparent"
                      Tag="{Binding}"
                      AllowDrop="True"
                      MouseRightButtonUp="FolderTile_RightClick"
                      DragEnter="FolderTile_DragEnter"
                      DragOver="FolderTile_DragOver"
                      DragLeave="FolderTile_DragLeave"
                      Drop="FolderTile_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Style="{StaticResource InvisibleButtonStyle}"
                            Tag="{Binding}"
                            Click="FolderTile_Click"
                            HorizontalAlignment="Center"
                            MouseEnter="TileScale_MouseEnter" MouseLeave="TileScale_MouseLeave">
                        <Grid x:Name="FolderIconGrid" Width="120" Height="160" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Viewbox Stretch="Uniform" MaxWidth="100" MaxHeight="120" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="96" Height="96">
                                    <Border Background="#FBBF24" Width="42" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,10,0,0" CornerRadius="8,8,0,0"/>
                                    <Border Background="#F59E0B" CornerRadius="14" Margin="6,22,6,10"/>
                                    <Border Background="#FDE68A" Height="10" Margin="18,42,18,0" VerticalAlignment="Top" CornerRadius="5"/>
                                    <Border Background="#FCD34D" Height="10" Margin="18,58,32,0" VerticalAlignment="Top" CornerRadius="5"/>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <TextBlock Grid.Row="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="150"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="2" Text="{Binding InfoText}" FontSize="12" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FileTileTemplate">
            <Border x:Name="FileTileBorder" Margin="20,12" Background="Transparent" CornerRadius="10" Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Width="160" Background="Transparent" Tag="{Binding}" MouseRightButtonUp="FileTile_RightClick">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Width="24"
                            Height="24"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,10,0"
                            CornerRadius="12"
                            BorderThickness="1"
                            IsHitTestVisible="False"
                            Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:LucideIcon Kind="Check" Width="13" Height="13" Stroke="{DynamicResource ThemeSelectionForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:LucideIcon.Style>
                                <Style TargetType="controls:LucideIcon">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:LucideIcon.Style>
                        </controls:LucideIcon>
                    </Border>

                    <Button Grid.Row="0" Style="{StaticResource InvisibleButtonStyle}"
                            Tag="{Binding}" Click="FileTile_Click" HorizontalAlignment="Center"
                            PreviewMouseLeftButtonDown="FileTile_PreviewMouseLeftButtonDown"
                             MouseMove="FileTile_MouseMove"
                             MouseEnter="TileScale_MouseEnter" MouseLeave="TileScale_MouseLeave">
                        <Grid x:Name="IconGrid" Width="120" Height="160" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Viewbox Stretch="Uniform" MaxWidth="90" MaxHeight="120" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="90" Height="120">
                                    <Rectangle Fill="#B88E75" RadiusX="5" RadiusY="5"/>
                                    <Rectangle Fill="#D94848" Width="12" HorizontalAlignment="Left" RadiusX="5" RadiusY="5"/>
                                    <Rectangle Fill="#D94848" Width="6" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                                    <Rectangle Fill="#A82824" Width="2" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                    <Border Background="#F5F5F5" CornerRadius="4" BorderBrush="#A08060" BorderThickness="1" Width="44" Height="22" Margin="24,16,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Rectangle Fill="#B0B0B0" Height="4" Width="24" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <TextBlock Grid.Row="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="150"
                               FontSize="13" Foreground="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"
                               ToolTip="{Binding Path}"/>

                    <TextBlock Grid.Row="2" Text="{Binding InfoText}" FontSize="12" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <local:HomeTileTemplateSelector x:Key="HomeTileTemplateSelector"
                                        AddTileTemplate="{StaticResource AddTileTemplate}"
                                        FolderTileTemplate="{StaticResource FolderTileTemplate}"
                                        FileTileTemplate="{StaticResource FileTileTemplate}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="HomeScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource SleekScrollViewer}"
                      PreviewMouseWheel="HomeScrollViewer_PreviewMouseWheel">
            <StackPanel>
                <Grid Margin="24,24,24,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HomeMarginRail"
                            Grid.Column="0"
                            Background="{DynamicResource ThemeMarginBrush}"
                            CornerRadius="2"/>
                    <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,14"
                                Visibility="{Binding IsInsideFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Click="NavigateUpButton_Click"
                                Style="{StaticResource InvisibleButtonStyle}"
                                Padding="0"
                                Margin="0,0,10,0">
                            <Border Background="{DynamicResource ThemePaperAltBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Kind="ArrowLeft" Width="14" Height="14" Stroke="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NavigateUpText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <TextBlock Text="{Binding FolderBreadcrumb}" FontSize="12" Foreground="{DynamicResource ThemeSubtleForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="HomeTitleTextBlock" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                    <TextBlock x:Name="HomeSubtitleTextBlock" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource ThemeSubtleForegroundBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    </Grid>
                <ItemsControl x:Name="TilesGrid"
                              ItemsSource="{Binding HomeTiles}"
                              ItemTemplateSelector="{StaticResource HomeTileTemplateSelector}"
                              Margin="12,4,12,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="DragDropOverlay"
                Grid.Row="0"
                Background="{DynamicResource ThemeSelectionBrush}"
                BorderBrush="{DynamicResource ThemeInkBrush}"
                BorderThickness="2"
                CornerRadius="14"
                Margin="24"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8">
                <controls:LucideIcon Kind="FilePlus" Width="38" Height="38" Stroke="{DynamicResource ThemeInkBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DragDropOverlayText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeInkBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="24,0,24,24"
                Padding="18,16"
                Background="{DynamicResource ThemeSidebarBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Visibility="{Binding IsSelectionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="{DynamicResource ThemeShadowOpacity}" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionSummary}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeForegroundBrush}"/>
                    <TextBlock Text="{Binding SelectionHint}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           ItemHeight="34">
                    <Button x:Name="SelectAllSelectionButton"
                            Click="SelectAllSelectionButton_Click"
                            Style="{StaticResource SelectionActionButtonStyle}"
                            Content="{Binding SelectionSelectAllText}"
                            IsEnabled="{Binding CanSelectAllTiles}"/>
                    <Button x:Name="ClearSelectionButton"
                            Click="ClearSelectionButton_Click"
                            Style="{StaticResource SelectionActionButtonStyle}"
                            Content="{Binding SelectionClearText}"
                            IsEnabled="{Binding HasSelectedTiles}"/>
                    <Button x:Name="MoveSelectionButton"
                            Click="MoveSelectionButton_Click"
                            Style="{StaticResource SelectionActionButtonStyle}"
                            Content="{Binding SelectionMoveText}"
                            IsEnabled="{Binding HasSelectedTiles}"/>
                    <Button x:Name="RemoveSelectionButton"
                            Click="RemoveSelectionButton_Click"
                            Style="{StaticResource SelectionDangerButtonStyle}"
                            Content="{Binding SelectionRemoveText}"
                            IsEnabled="{Binding HasSelectedTiles}"/>
                    <Button x:Name="DoneSelectionButton"
                            Click="DoneSelectionButton_Click"
                            Style="{StaticResource SelectionActionButtonStyle}"
                            Content="{Binding SelectionDoneText}"
                            Margin="0"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

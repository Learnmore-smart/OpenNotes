<Page x:Class="Caelum.Pages.EditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      Background="{DynamicResource ThemeWindowBackgroundBrush}"
      AllowDrop="True"
      PreviewMouseDown="EditorPage_PreviewMouseDown"
      PreviewStylusDown="EditorPage_PreviewStylusDown"
      PreviewKeyDown="EditorPage_PreviewKeyDown">

    <Page.Resources>
        <!-- Toolbar button -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Undo/redo button: icon color reflects enabled state.
             The child TextBlock has no local Foreground so it inherits the
             button's Foreground (TextElement inheritance), which the trigger
             switches to gray while disabled. -->
        <Style x:Key="UndoRedoButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeDisabledForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toolbar toggle button -->
        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Rectangle x:Name="ActiveBar" Fill="{DynamicResource ThemeAccentBrush}" Height="3" VerticalAlignment="Bottom"
                                       HorizontalAlignment="Stretch" RadiusX="1.5" RadiusY="1.5"
                                       Margin="6,0,6,2" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlPressedBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinHeight" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Selectable PDF surface. The annotation stack is image-based, so text
             selection has to come from a native PDF viewer control. -->
        <Grid x:Name="SelectablePdfContainer"
              Visibility="Collapsed"
              Margin="0,70,0,0"
              Background="{DynamicResource ThemeCanvasBrush}">
            <wfi:WindowsFormsHost x:Name="SelectablePdfHost" />
        </Grid>

        <!-- PDF Pages Container (full area) -->
        <ScrollViewer x:Name="PdfScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Background="{DynamicResource ThemeCanvasBrush}"
                      Style="{StaticResource SleekScrollViewer}"
                      PanningMode="None"
                      Stylus.IsFlicksEnabled="False"
                      IsManipulationEnabled="True"
                      PreviewStylusDown="PdfScrollViewer_PreviewStylusDown"
                      PreviewStylusMove="PdfScrollViewer_PreviewStylusMove"
                      PreviewStylusUp="PdfScrollViewer_PreviewStylusUp"
                      PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel"
                      PreviewMouseDown="PdfScrollViewer_PreviewMouseDown"
                      PreviewMouseMove="PdfScrollViewer_PreviewMouseMove"
                      PreviewMouseUp="PdfScrollViewer_PreviewMouseUp"
                      ManipulationStarting="PdfScrollViewer_ManipulationStarting"
                      ManipulationDelta="PdfScrollViewer_ManipulationDelta"
                      ManipulationInertiaStarting="PdfScrollViewer_ManipulationInertiaStarting"
                      PreviewTouchDown="PdfScrollViewer_PreviewTouchDown"
                      PreviewTouchMove="PdfScrollViewer_PreviewTouchMove"
                      PreviewTouchUp="PdfScrollViewer_PreviewTouchUp"
                      PreviewMouseRightButtonUp="PdfScrollViewer_PreviewMouseRightButtonUp">
            <ScrollViewer.ContextMenu>
                <ContextMenu x:Name="PdfViewerContextMenu">
                    <MenuItem x:Name="PrintMenuItem" InputGestureText="Ctrl+P" Click="ContextMenu_PrintClick">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="ExportCurrentPagePng1xMenuItem" Click="ExportCurrentPagePng1x_Click"/>
                    <MenuItem x:Name="ExportCurrentPagePng2xMenuItem" Click="ExportCurrentPagePng2x_Click"/>
                    <MenuItem x:Name="ExportAllPagesPng1xMenuItem" Click="ExportAllPagesPng1x_Click"/>
                    <MenuItem x:Name="ExportAllPagesPng2xMenuItem" Click="ExportAllPagesPng2x_Click"/>
                    <Separator/>
                    <MenuItem x:Name="InsertPdfPageMenuItem" Click="InsertPdfPages_Click"/>
                    <MenuItem x:Name="InsertImagePageMenuItem" Click="InsertImagePage_Click"/>
                    <MenuItem x:Name="RotateCurrentPageMenuItem" Click="RotateCurrentPage_Click"/>
                </ContextMenu>
            </ScrollViewer.ContextMenu>
            <StackPanel x:Name="PagesContainer" Margin="32,20,32,32" HorizontalAlignment="Center">
                <StackPanel.LayoutTransform>
                    <ScaleTransform x:Name="PagesZoomTransform" ScaleX="1" ScaleY="1"/>
                </StackPanel.LayoutTransform>
            </StackPanel>
        </ScrollViewer>

        <!-- Task 22: on-screen ruler overlay. Viewport-anchored (never moves
             with the document — like a real ruler lying on the screen) and
             spans across pages. The canvas has no background, so its empty
             areas are hit-test transparent: pointer events pass through to
             the scroll viewer below; only the ruler element built in code
             is interactive. Sits below the floating toolbar in z-order but
             above the scroll viewer. -->
        <Canvas x:Name="RulerOverlayCanvas"/>

        <!-- Floating Toolbar -->
        <Border x:Name="ToolbarBorder" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,12,0,0" Padding="8,4" CornerRadius="14"
                Background="{DynamicResource ThemePaperBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.12" Color="#000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" Height="42">
                <!-- Undo -->
                <Button x:Name="UndoButton" Click="UndoButton_Click"
                        Style="{StaticResource UndoRedoButtonStyle}"
                        Width="42" Height="36" Margin="2,0" IsEnabled="False">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="17"/>
                </Button>

                <!-- Redo -->
                <Button x:Name="RedoButton" Click="RedoButton_Click"
                        Style="{StaticResource UndoRedoButtonStyle}"
                        Width="42" Height="36" Margin="2,0" IsEnabled="False">
                    <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="17"/>
                </Button>

                <!-- Separator -->
                <Border Width="1" Background="{DynamicResource ThemeMenuSeparatorBrush}" Margin="4,8"/>

                <!-- Pen -->
                <ToggleButton x:Name="PenToolButton" Click="PenToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock x:Name="PenIcon" Text="&#xED63;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </ToggleButton>

                <!-- Highlighter -->
                <ToggleButton x:Name="HighlighterToolButton" Click="HighlighterToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock x:Name="HighlighterIcon" Text="&#xE7E6;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource ThemeMarkBrush}"/>
                </ToggleButton>

                <!-- Study mode: freehand opaque mask, click to reveal briefly. -->
                <ToggleButton x:Name="HiddenInkToolButton" Click="HiddenInkToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                </ToggleButton>

                <!-- Task 26: place a collapsible sticky-note annotation. -->
                <ToggleButton x:Name="StickyNoteToolButton" Click="StickyNoteToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource ThemeMarkBrush}"/>
                </ToggleButton>

                <!-- Task 23: pen preset slots (3). Populated in code by
                     InitializePenPresetSlots: left-click applies the preset
                     (tool + color + size), right-click captures the current
                     Pen/Highlighter state into the slot. -->
                <StackPanel x:Name="PresetSlotsPanel" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="4,0,2,0"/>

                <!-- Eraser -->
                <ToggleButton x:Name="EraserToolButton" Click="EraserToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock x:Name="EraserIcon" Text="&#xE75C;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </ToggleButton>

                <!-- Shape -->
                <ToggleButton x:Name="ShapeToolButton" Click="ShapeToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock x:Name="ShapeIcon" Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </ToggleButton>

                <!-- Laser pointer (ephemeral ink that fades away; never saved) -->
                <ToggleButton x:Name="LaserToolButton" Click="LaserToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource ThemeMarginBrush}"/>
                </ToggleButton>

                <!-- Task 22: on-screen ruler toggle. Overlay only — independent
                     of the active tool (pick Pen + ruler ON); movable/rotatable,
                     pen strokes near its edge snap onto it. Never saved. -->
                <ToggleButton x:Name="RulerToolButton" Click="RulerToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock x:Name="RulerIcon" Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </ToggleButton>

                <!-- Select -->
                <ToggleButton x:Name="SelectToolButton" Click="SelectToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock x:Name="SelectIcon" Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </ToggleButton>

                <Border Width="1" Background="{DynamicResource ThemeMenuSeparatorBrush}" Margin="4,8"/>

                <!-- Text -->
                <ToggleButton x:Name="TextToolButton" Click="TextToolButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock Text="A" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </ToggleButton>

                <!-- Save -->
                <Button x:Name="SavePdfButton" Click="SavePdf_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </Button>

                <!-- Version History -->
                <Button x:Name="VersionHistoryButton" Click="VersionHistory_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </Button>

                <!-- Separator -->
                <Border Width="1" Background="{DynamicResource ThemeMenuSeparatorBrush}" Margin="4,8"/>

                <!-- Page Number -->
                <Border x:Name="PageJumpBorder"
                        Style="{StaticResource ToolbarFieldBorderStyle}"
                        Margin="8,0,8,0"
                        Cursor="Hand"
                        MouseLeftButtonDown="PageJumpBorder_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="38" Height="22" Margin="0,0,4,0">
                            <TextBlock x:Name="PageNumberLabel" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBox x:Name="PageNumberTextBox" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundBrush}" Background="Transparent"
                                     VerticalAlignment="Center" HorizontalAlignment="Center"
                                     Width="38" Height="22" TextAlignment="Center" Padding="0"
                                     BorderThickness="0" FocusVisualStyle="{x:Null}"
                                      CaretBrush="{DynamicResource ThemeAccentBrush}" SelectionBrush="{DynamicResource ThemeSelectionBrush}"
                                     Visibility="Collapsed"
                                     KeyDown="PageNumberTextBox_KeyDown"
                                     LostFocus="PageNumberTextBox_LostFocus"/>
                        </Grid>
                         <TextBlock x:Name="PageCountText" Text="/ 0" FontSize="13" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Separator -->
                <Border Width="1" Background="{DynamicResource ThemeMenuSeparatorBrush}" Margin="4,8"/>

                <!-- Pen-only drawing (palm rejection): only the stylus creates ink -->
                <ToggleButton x:Name="PenOnlyButton" Click="PenOnlyButton_Click"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        Width="36" Height="36" Margin="2,0">
                    <TextBlock x:Name="PenOnlyIcon" Text="&#xE7C9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </ToggleButton>

                <!-- Zoom Out -->
                <Button x:Name="ZoomOutButton" Click="ZoomOutButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="36" Height="36" Margin="2,0">
                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </Button>

                <!-- Zoom Percentage (click to edit) -->
                <Grid Width="46" Height="36" Margin="0,0,0,0">
                    <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12" Foreground="{DynamicResource ThemeForegroundBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                               MouseLeftButtonDown="ZoomLabel_MouseLeftButtonDown"
                               Cursor="Hand"/>
                    <TextBox x:Name="ZoomTextBox" FontSize="12" Foreground="{DynamicResource ThemeForegroundBrush}" Background="{DynamicResource ThemePaperAltBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             Width="42" Height="22" TextAlignment="Center" Padding="2,1"
                              BorderThickness="1" BorderBrush="{DynamicResource ThemeFocusBrush}"
                             Visibility="Collapsed"
                             KeyDown="ZoomTextBox_KeyDown"
                             LostFocus="ZoomTextBox_LostFocus"/>
                </Grid>

                <!-- Zoom In -->
                <Button x:Name="ZoomInButton" Click="ZoomInButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="36" Height="36" Margin="2,0">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </Button>

                <Button x:Name="FitWidthButton" Click="FitWidthButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="54" Height="36" Margin="2,0">
                    <TextBlock x:Name="FitWidthLabel" FontSize="11" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </Button>
                <Button x:Name="FitPageButton" Click="FitPageButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="54" Height="36" Margin="2,0">
                    <TextBlock x:Name="FitPageLabel" FontSize="11" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </Button>
                <Button x:Name="RotatePageButton" Click="RotateCurrentPage_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </Button>

                <!-- Task 16: keyboard-accessible immersive reading mode. -->
                <Button x:Name="ImmersiveModeButton" Click="ImmersiveModeButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="42" Height="36" Margin="2,0">
                    <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </Button>


             </StackPanel>
        </Border>

        <!-- Tasks 30–32: document navigation sidebar. It is an overlay so the
             PDF canvas keeps its existing scroll/zoom geometry. -->
        <Border x:Name="DocumentSidebar"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Margin="12,70,0,12"
                Width="184"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Panel.ZIndex="20">
            <DockPanel>
                <Button x:Name="SidebarCollapseButton" DockPanel.Dock="Top" Height="28" Margin="6"
                        Click="SidebarCollapseButton_Click"/>
                <TabControl x:Name="DocumentSidebarTabs" Background="Transparent" BorderThickness="0">
                <TabItem x:Name="PagesTabItem">
                    <ListBox x:Name="ThumbnailListBox"
                             Margin="6"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AllowDrop="True"
                             SelectionChanged="ThumbnailListBox_SelectionChanged"
                             PreviewMouseLeftButtonDown="ThumbnailListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ThumbnailListBox_PreviewMouseMove"
                             Drop="ThumbnailListBox_Drop"/>
                </TabItem>
                <TabItem x:Name="OutlineTabItem">
                    <TreeView x:Name="OutlineTreeView" Margin="6" BorderThickness="0" Background="Transparent"/>
                </TabItem>
                <TabItem x:Name="BookmarksTabItem">
                    <DockPanel>
                        <Button x:Name="BookmarkToggleButton" DockPanel.Dock="Top" Margin="8" Height="30"
                                Click="BookmarkToggleButton_Click"/>
                        <ListBox x:Name="BookmarksListBox" Margin="6" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="BookmarksListBox_SelectionChanged"/>
                    </DockPanel>
                </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- Task 32: asynchronous full-document search results. -->
        <Border x:Name="PdfSearchPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12,70,12,0"
                Width="390"
                Height="330"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="10"
                Visibility="Collapsed"
                Panel.ZIndex="25">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PdfSearchTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             KeyDown="PdfSearchTextBox_KeyDown" TextChanged="PdfSearchTextBox_TextChanged"/>
                    <Button Grid.Column="1" Width="30" Content="×" Click="ClosePdfSearchButton_Click"/>
                </Grid>
                <TextBlock x:Name="PdfSearchStatusTextBlock" DockPanel.Dock="Bottom" Margin="2,6,2,0"
                           Foreground="{DynamicResource ThemeSubtleForegroundBrush}" FontSize="11"/>
                <ListBox x:Name="PdfSearchResultsListBox" Margin="0,8,0,0" BorderThickness="0"
                         SelectionChanged="PdfSearchResultsListBox_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Eraser Size Preview Overlay -->
        <Ellipse x:Name="EraserSizePreviewEllipse"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#0078D4" StrokeThickness="1.5" Fill="#150078D4"
                 IsHitTestVisible="False" Visibility="Collapsed"
                 Panel.ZIndex="10"/>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay"
              Background="{DynamicResource ThemeSurfaceBrush}" Opacity="0.92" Visibility="Collapsed">
            <Border CornerRadius="14" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ThemeSurfaceBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.10" Color="#000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="LoadingRing" Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource ThemeAccentBrush}" RenderTransformOrigin="0.5,0.5" Margin="0,0,12,0">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="LoadingRotate" Angle="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=LoadingOverlay}" Value="Visible">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="LoadingStoryboard">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="LoadingText" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>



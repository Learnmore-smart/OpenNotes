<Application
    x:Class="Caelum.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppGlassPanelBrush" Color="White" Opacity="0.08"/>
            <SolidColorBrush x:Key="AppGlassSurfaceBrush" Color="White" Opacity="0.12"/>
            <SolidColorBrush x:Key="AppGlassSurfaceHoverBrush" Color="White" Opacity="0.18"/>
            <SolidColorBrush x:Key="AppGlassSurfacePressedBrush" Color="White" Opacity="0.24"/>
            <SolidColorBrush x:Key="AppGlassBorderBrush" Color="White" Opacity="0.22"/>
            <SolidColorBrush x:Key="AppGlassSubtleBorderBrush" Color="White" Opacity="0.10"/>
            <!-- Task 39: runtime-swappable application chrome palette. -->
            <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeSurfaceAltBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="ThemeCanvasBrush" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="ThemeBorderBrush" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="ThemeForegroundBrush" Color="#1F2937"/>
            <SolidColorBrush x:Key="ThemeSubtleForegroundBrush" Color="#4B5563"/>
            <SolidColorBrush x:Key="ThemeControlHoverBrush" Color="#EEF0F2"/>
            <SolidColorBrush x:Key="ThemeControlPressedBrush" Color="#E2E5E9"/>
            <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#DBEAFE"/>
            <SolidColorBrush x:Key="ThemeSelectionForegroundBrush" Color="#1E40AF"/>
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="ThemeAccentPressedBrush" Color="#1E40AF"/>
            <SolidColorBrush x:Key="ThemeDisabledForegroundBrush" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="ThemeScrollbarTrackBrush" Color="#1F52606C"/>
            <SolidColorBrush x:Key="ThemeScrollbarThumbBrush" Color="#A85C6975"/>
            <SolidColorBrush x:Key="ThemeScrollbarThumbHoverBrush" Color="#CC394B5A"/>
            <SolidColorBrush x:Key="ThemeScrollbarThumbPressedBrush" Color="#E8212D38"/>
            <SolidColorBrush x:Key="ThemeSliderTrackBrush" Color="#221C5D99"/>
            <SolidColorBrush x:Key="ThemeMenuSeparatorBrush" Color="#1F1E2933"/>
            <SolidColorBrush x:Key="ThemeFocusBrush" Color="#154F86"/>
            <SolidColorBrush x:Key="ThemeDeskBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemePaperBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemePaperAltBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="ThemeInkBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="ThemeMarginBrush" Color="#C2414B"/>
            <SolidColorBrush x:Key="ThemeMarkBrush" Color="#D9A72E"/>
            <!-- Wave5 semantic aliases. ThemeService replaces these at runtime. -->
            <SolidColorBrush x:Key="ThemeWindowBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeWorkspaceBackdropBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeWorkspaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="ThemeToolbarBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeControlBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="ThemeTextBrush" Color="#1F2937"/>
            <SolidColorBrush x:Key="ThemeSubtleTextBrush" Color="#4B5563"/>
            <SolidColorBrush x:Key="ThemeDangerBrush" Color="#B42318"/>
            <Duration x:Key="ThemeAnimationDuration">0:0:0.16</Duration>
            <sys:Double x:Key="ThemeSurfaceOpacity">0.96</sys:Double>
            <sys:Double x:Key="ThemeShadowOpacity">0.12</sys:Double>

            <!-- Shared toolbar focus ring: an adornment keeps the 32 DIP target
                 stable while remaining visible across light, dark and high
                 contrast resource palettes. -->
            <Style x:Key="ToolbarFocusVisualStyle" TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Control">
                            <Border BorderBrush="{DynamicResource ThemeFocusBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Margin="-2">
                                <AdornedElementPlaceholder/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Settings uses an explicit two-DIP focus affordance for every
                 keyboard-reachable control, including custom templates.  The
                 brush is DynamicResource so OS High Contrast can replace it
                 with System Highlight at runtime. -->
            <Style x:Key="SettingsFocusVisualStyle" TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Control">
                            <Border BorderBrush="{DynamicResource ThemeFocusBrush}"
                                    BorderThickness="2"
                                    CornerRadius="7"
                                    Margin="-2">
                                <AdornedElementPlaceholder/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shared code-created popup styles. EditorPage keeps matching
                 page-local keys for declarative toolbar controls; these app
                 resources make runtime-created popup controls use the same
                 theme, checked cue, disabled state, and focus contract. -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocusVisualStyle}"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocusVisualStyle}"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Rectangle x:Name="ActiveBar" Fill="{DynamicResource ThemeAccentBrush}" Height="3" VerticalAlignment="Bottom"
                                           HorizontalAlignment="Stretch" RadiusX="1.5" RadiusY="1.5"
                                           Margin="6,0,6,2" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/>
                                    <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlPressedBrush}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?Sleek ScrollBar 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
            <Style x:Key="SleekScrollBarThumb" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbBorder"
                                    Margin="1"
                                    Background="{DynamicResource ThemeScrollbarThumbBrush}"
                                    BorderThickness="0"
                                    CornerRadius="4"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeScrollbarThumbHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeScrollbarThumbPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SleekVerticalScrollBarThumb" TargetType="Thumb" BasedOn="{StaticResource SleekScrollBarThumb}">
                <Setter Property="MinHeight" Value="24"/>
            </Style>

            <Style x:Key="SleekHorizontalScrollBarThumb" TargetType="Thumb" BasedOn="{StaticResource SleekScrollBarThumb}">
                <Setter Property="MinWidth" Value="24"/>
            </Style>

            <Style x:Key="SleekVerticalScrollBar" TargetType="ScrollBar">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Width" Value="6"/>
                <Setter Property="MinWidth" Value="6"/>
                <Setter Property="Margin" Value="2,2,2,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" CornerRadius="4">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SleekVerticalScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Width" Value="8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SleekHorizontalScrollBar" TargetType="ScrollBar">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Margin" Value="2,2,2,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" CornerRadius="4">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SleekHorizontalScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Height" Value="8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource SleekVerticalScrollBar}">
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="6"/>
                        <Setter Property="MinHeight" Value="6"/>
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Border Background="Transparent" CornerRadius="4">
                                        <Track x:Name="PART_Track">
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource SleekHorizontalScrollBarThumb}"/>
                                            </Track.Thumb>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Orientation" Value="Horizontal"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Height" Value="8"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SleekScrollViewer" TargetType="ScrollViewer">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="{TemplateBinding Padding}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Orientation="Vertical"
                                           Style="{StaticResource SleekVerticalScrollBar}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                           Opacity="{DynamicResource ThemeSurfaceOpacity}"/>
                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Orientation="Horizontal"
                                           Style="{StaticResource SleekHorizontalScrollBar}"
                                           Maximum="{TemplateBinding ScrollableWidth}"
                                           Value="{TemplateBinding HorizontalOffset}"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                           Opacity="{DynamicResource ThemeSurfaceOpacity}"/>
                                <Border Grid.Row="1" Grid.Column="1" Background="Transparent"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
                                    <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollViewer" BasedOn="{StaticResource SleekScrollViewer}"/>

            <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?Modern ComboBox 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
            <Style x:Key="ModernComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource ThemeControlBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="ItemContainerStyle" Value="{DynamicResource ModernComboBoxItem}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid x:Name="ComboRoot">
                                <ToggleButton x:Name="ToggleButton" Focusable="False"
                                              Background="{TemplateBinding Background}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                <Grid>
                                                    <Path Data="M9,18 L15,12 L9,6" Stretch="Uniform" StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="13" Height="13" Stroke="{DynamicResource ThemeSubtleForegroundBrush}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="90"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeControlPressedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  Margin="16,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="{DynamicResource ThemePopupAnimation}">
                                    <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}">
                                        <Border x:Name="DropDownBorder" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="16" Margin="0,6,0,0"
                                                Padding="6" Opacity="{DynamicResource ThemeSurfaceOpacity}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="{DynamicResource ThemeShadowOpacity}" Color="#000"/>
                                            </Border.Effect>
                                            <ScrollViewer Margin="0" SnapsToDevicePixels="True" Style="{StaticResource SleekScrollViewer}">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                                <Border x:Name="FocusRing"
                                        BorderBrush="{DynamicResource ThemeFocusBrush}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Margin="-1"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ComboRoot" Property="Opacity" Value="0.55"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleTextBrush}"/>
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSelectionForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?Modern Dialog Button 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
            <Style x:Key="CompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>

            <Style x:Key="DialogPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeSurfaceBrush}"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ButtonRoot">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="FocusRing" BorderBrush="{DynamicResource ThemeFocusBrush}" BorderThickness="2"
                                        CornerRadius="8" Margin="-1" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleTextBrush}"/>
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DialogSecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ButtonRoot">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,0"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="FocusRing" BorderBrush="{DynamicResource ThemeFocusBrush}" BorderThickness="2"
                                        CornerRadius="8" Margin="-1" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeControlPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleTextBrush}"/>
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?Glass Popup Border 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
            <Style x:Key="GlassPopupBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ThemePaperBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Opacity" Value="{DynamicResource ThemeSurfaceOpacity}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="{DynamicResource ThemeShadowOpacity}" Color="#333"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?Sleek Slider 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
            <Style TargetType="Slider">
                <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocusVisualStyle}"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid x:Name="SliderRoot" VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Background="{DynamicResource ThemeSliderTrackBrush}" VerticalAlignment="Center" Margin="9,0"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{DynamicResource ThemeAccentBrush}" CornerRadius="2" Height="4" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid>
                                                        <Ellipse Width="18" Height="18" Fill="{DynamicResource ThemeSurfaceBrush}">
                                                            <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="{DynamicResource ThemeShadowOpacity}"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                        <Ellipse x:Name="ThumbDot" Width="10" Height="10" Fill="{DynamicResource ThemeAccentBrush}"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbDot" Property="Width" Value="12"/>
                                                            <Setter TargetName="ThumbDot" Property="Height" Value="12"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbDot" Property="Width" Value="8"/>
                                                            <Setter TargetName="ThumbDot" Property="Height" Value="8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                                <Border x:Name="SliderFocusRing"
                                        BorderBrush="{DynamicResource ThemeFocusBrush}"
                                        BorderThickness="2"
                                        CornerRadius="5"
                                        Margin="0,-2"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="SliderFocusRing" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SliderRoot" Property="Opacity" Value="0.55"/>
                                    <Setter TargetName="SliderFocusRing" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?Windows 11 Context Menu 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
            <Style TargetType="ContextMenu">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <!-- Outer border to provide margin space so drop shadow doesn't clip on the popup bounds -->
                            <Border Background="Transparent" Padding="12">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Opacity="{DynamicResource ThemeSurfaceOpacity}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="{DynamicResource ThemeShadowOpacity}" Color="#000"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" Style="{StaticResource SleekScrollViewer}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?Windows 11 Menu Item 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
            <Style TargetType="MenuItem">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="TemplateRoot" Background="{TemplateBinding Background}" CornerRadius="5" Margin="2,1" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="GestureText"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="IconPresenter" Content="{TemplateBinding Icon}" Margin="8,0,0,0" VerticalAlignment="Center" Width="16" Height="16"/>
                                    <ContentPresenter x:Name="HeaderHost" Grid.Column="1" RecognizesAccessKey="True" ContentSource="Header" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InputGestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="TemplateRoot" Property="Background" Value="{DynamicResource ThemeControlHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeDisabledForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?Separator in ContextMenu 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Background" Value="{DynamicResource ThemeMenuSeparatorBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border BorderBrush="{TemplateBinding Background}" BorderThickness="0,1,0,0"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

<Window
    x:Class="Caelum.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Caelum.Models"
    Title="OpenNotes">

    <!--
        V6 chrome: ExtendsContentIntoTitleBar + SetTitleBar(AppTitleBar) replaces
        the WPF WindowChrome(CaptionHeight=40). The AppTitleBar grid is the drag
        surface (double-click maximize and system menu come free with the real
        caption rect); interactive controls placed over it get input through the
        framework's automatic passthrough regions. Caption buttons are custom
        buttons driven by AppWindow/OverlappedPresenter, mirroring the WPF
        WindowStyle=None custom chrome. ExtendsContentIntoTitleBar alone leaves
        the SYSTEM caption buttons rendered topmost over the right edge -
        code-behind ApplyCustomChrome() calls
        OverlappedPresenter.SetBorderAndTitleBar(hasBorder: true,
        hasTitleBar: false) so these XAML buttons are the only caption UI.
    -->

    <Grid x:Name="RootGrid" Background="{ThemeResource ThemeWindowBrush}" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.Resources>
            <!-- 28px pill toolbar button (WPF NavButtonStyle). -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource ThemeSubtleForegroundBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.3"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 46x40 caption button (WPF TitleBarButtonStyle). -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource ThemeSubtleForegroundBrush}"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.55"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Red-hover close button (WPF CloseButtonStyle). ContentPresenter
                 Foreground drives the glyph to white on hover/pressed. -->
            <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="0,8,0,0">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#C42B1C"/>
                                                <Setter Target="Content.Foreground" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#B22A1B"/>
                                                <Setter Target="Content.Foreground" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.55"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Transparent container; the tab pill itself paints all chrome. -->
            <Style x:Key="TabListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="TabNavigation" Value="Local"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One tab pill: icon + title + close button. Chrome binds to the
                 AppTab's computed properties so active/inactive state stays
                 declarative (WPF ApplyTabChrome equivalent). -->
            <DataTemplate x:Key="TabItemTemplate" x:DataType="models:AppTab">
                <Border Height="32" MinWidth="72" CornerRadius="10" Margin="0,0,4,0"
                        Padding="10,0,4,0" BorderThickness="1"
                        Background="{x:Bind TabBackground, Mode=OneWay}"
                        BorderBrush="{x:Bind TabBorderBrush, Mode=OneWay}"
                        AutomationProperties.AutomationId="AppTab"
                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
                        PointerPressed="TabItem_PointerPressed"
                        PointerEntered="TabItem_PointerEntered"
                        PointerExited="TabItem_PointerExited">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="12"
                                  Margin="0,0,6,0" VerticalAlignment="Center"
                                  Foreground="{x:Bind TabForeground, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" FontSize="13"
                                   MaxWidth="132" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontWeight="{x:Bind TitleFontWeight, Mode=OneWay}"
                                   Foreground="{x:Bind TabForeground, Mode=OneWay}"/>
                        <Button x:Name="TabCloseButton" Width="24" Height="24" Padding="0"
                                Margin="2,0,-4,0"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind CloseButtonVisibility, Mode=OneWay}"
                                Opacity="{x:Bind CloseButtonOpacity, Mode=OneWay}"
                                AutomationProperties.AutomationId="TabCloseButton"
                                AutomationProperties.Name="{x:Bind CloseTooltip, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind CloseTooltip, Mode=OneWay}"
                                PointerPressed="TabCloseButton_PointerPressed"
                                Click="TabCloseButton_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="9"
                                      Foreground="{x:Bind TabForeground, Mode=OneWay}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar row (WPF TitleBarBorder). AppTitleBar is the
             SetTitleBar drag surface; the buttons are overlay siblings so the
             framework keeps them hit-testable over the caption rect. -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="{ThemeResource ThemeToolbarBrush}">
            <!-- Drag surface (SetTitleBar target): brand visuals + nav cluster
                 flow left-to-right exactly like the WPF title bar. Interactive
                 children are automatically excluded from the caption rect by
                 the framework's passthrough handling. -->
            <Grid x:Name="AppTitleBar">
                <Border x:Name="BrandMarginRail"
                        Width="3"
                        Margin="8,8,0,8"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource ThemeMarginBrush}"
                        CornerRadius="2"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,138,0">
                    <TextBlock x:Name="ProductNameTextBlock" Text="OpenNotes" FontSize="13"
                               Foreground="{ThemeResource ThemeForegroundBrush}"
                               Margin="14,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button x:Name="NavBackButton" Click="NavBack_Click" Style="{StaticResource NavButtonStyle}"
                            IsEnabled="False" AutomationProperties.AutomationId="NavBackButton"
                            AutomationProperties.Name="Back">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="{ThemeResource ThemeSubtleForegroundBrush}"/>
                    </Button>
                    <Button x:Name="NavForwardButton" Click="NavForward_Click" Style="{StaticResource NavButtonStyle}"
                            IsEnabled="False" Margin="2,0,0,0" AutomationProperties.AutomationId="NavForwardButton"
                            AutomationProperties.Name="Forward">
                        <FontIcon Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource ThemeSubtleForegroundBrush}"/>
                    </Button>
                    <Button x:Name="NavHomeButton" Click="NavHome_Click" Style="{StaticResource NavButtonStyle}"
                            Margin="2,0,0,0" AutomationProperties.AutomationId="NavHomeButton"
                            AutomationProperties.Name="Home">
                        <FontIcon Glyph="&#xE80F;" FontSize="13" Foreground="{ThemeResource ThemeSubtleForegroundBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}"
                        AutomationProperties.AutomationId="MinimizeButton" AutomationProperties.Name="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton" Click="MaximizeButton_Click" Style="{StaticResource TitleBarButtonStyle}"
                        AutomationProperties.AutomationId="MaximizeButton" AutomationProperties.Name="Maximize">
                    <FontIcon x:Name="MaximizeIcon" Glyph="&#xE922;" FontSize="10"/>
                </Button>
                <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource CloseButtonStyle}"
                        AutomationProperties.AutomationId="CloseButton" AutomationProperties.Name="Close">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tab strip (WPF TabBar): horizontal ListView gives in-place
             drag-reorder; activation rides on single selection. -->
        <Border Grid.Row="1" Background="{ThemeResource ThemePaperBrush}"
                BorderBrush="{ThemeResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4,8,4">
            <ScrollViewer Height="32" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ListView x:Name="TabStrip"
                              ItemsSource="{x:Bind _tabs, Mode=OneTime}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              AllowDrop="True"
                              CanReorderItems="True"
                              IsItemClickEnabled="True"
                              ItemTemplate="{StaticResource TabItemTemplate}"
                              ItemContainerStyle="{StaticResource TabListViewItemStyle}"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              SelectionChanged="TabStrip_SelectionChanged"
                              DragItemsStarting="TabStrip_DragItemsStarting"
                              DragItemsCompleted="TabStrip_DragItemsCompleted"
                              AutomationProperties.AutomationId="TabStrip">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                    <Button x:Name="NewTabButton" Click="NewTab_Click" Style="{StaticResource NavButtonStyle}"
                            VerticalAlignment="Center" Width="32" Height="32" Margin="6,0,0,0"
                            AutomationProperties.AutomationId="NewTabButton" AutomationProperties.Name="New tab">
                        <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource ThemeSubtleForegroundBrush}"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Per-tab navigation hosts (WPF TabContentArea): one Frame per tab,
             only the active one visible. -->
        <Grid x:Name="TabContentArea" Grid.Row="2"/>
    </Grid>
</Window>

<Application
    x:Class="Caelum.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Glass overlay tokens. Kept at root level (never theme-switched),
                 exactly as the WPF App.xaml defines them. -->
            <SolidColorBrush x:Key="AppGlassPanelBrush" Color="White" Opacity="0.08"/>
            <SolidColorBrush x:Key="AppGlassSurfaceBrush" Color="White" Opacity="0.12"/>
            <SolidColorBrush x:Key="AppGlassSurfaceHoverBrush" Color="White" Opacity="0.18"/>
            <SolidColorBrush x:Key="AppGlassSurfacePressedBrush" Color="White" Opacity="0.24"/>
            <SolidColorBrush x:Key="AppGlassBorderBrush" Color="White" Opacity="0.22"/>
            <SolidColorBrush x:Key="AppGlassSubtleBorderBrush" Color="White" Opacity="0.10"/>

            <!-- Runtime-swappable application chrome palette (WPF Task 39).
                 Root-level entries hold the ThemeService LightPalette values
                 (pure-white #FFFFFF window/surface — deliberately NOT the
                 #F3F4F6/#E5E7EB baseline the WPF App.xaml root carries, which
                 is only its pre-theme placeholder; at runtime WPF replaces
                 those placeholders with the same LightPalette values used
                 here). WinUiThemeService.Apply replaces them in place whenever
                 the effective theme changes — that in-place rewrite is the
                 ONLY palette-switch mechanism: there are deliberately NO
                 ResourceDictionary.ThemeDictionaries for these keys because
                 root entries always win lookup (Current → Merged → Theme), so
                 a RequestedTheme flip could never reach them. Key NAMES are
                 identical to WPF so ported XAML keeps binding via
                 {ThemeResource}. -->
            <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeSurfaceAltBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="ThemeCanvasBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeBorderBrush" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="ThemeForegroundBrush" Color="#1F2937"/>
            <SolidColorBrush x:Key="ThemeSubtleForegroundBrush" Color="#4B5563"/>
            <SolidColorBrush x:Key="ThemeControlHoverBrush" Color="#EEF0F2"/>
            <SolidColorBrush x:Key="ThemeControlPressedBrush" Color="#E2E5E9"/>
            <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#DBEAFE"/>
            <SolidColorBrush x:Key="ThemeSelectionForegroundBrush" Color="#1E40AF"/>
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="ThemeAccentPressedBrush" Color="#1E40AF"/>
            <SolidColorBrush x:Key="ThemeDisabledForegroundBrush" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="ThemeScrollbarTrackBrush" Color="#1F52606C"/>
            <SolidColorBrush x:Key="ThemeScrollbarThumbBrush" Color="#A85C6975"/>
            <SolidColorBrush x:Key="ThemeScrollbarThumbHoverBrush" Color="#CC394B5A"/>
            <SolidColorBrush x:Key="ThemeScrollbarThumbPressedBrush" Color="#E8212D38"/>
            <SolidColorBrush x:Key="ThemeSliderTrackBrush" Color="#221C5D99"/>
            <SolidColorBrush x:Key="ThemeMenuSeparatorBrush" Color="#1F1E2933"/>
            <SolidColorBrush x:Key="ThemeFocusBrush" Color="#154F86"/>
            <SolidColorBrush x:Key="ThemeDeskBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemePaperBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemePaperAltBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="ThemeInkBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="ThemeMarginBrush" Color="#C2414B"/>
            <SolidColorBrush x:Key="ThemeMarkBrush" Color="#D9A72E"/>
            <SolidColorBrush x:Key="ThemeDangerBrush" Color="#FFB42318"/>
            <SolidColorBrush x:Key="ThemeWindowOutlineBrush" Color="#1F2937"/>
            <!-- Wave5 semantic aliases. WinUiThemeService rewrites these at runtime. -->
            <SolidColorBrush x:Key="ThemeWindowBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeWorkspaceBackdropBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeWorkspaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="ThemeToolbarBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeControlBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="ThemeTextBrush" Color="#1F2937"/>
            <SolidColorBrush x:Key="ThemeSubtleTextBrush" Color="#4B5563"/>
            <Duration x:Key="ThemeAnimationDuration">0:0:0.16</Duration>
            <x:Double x:Key="ThemeSurfaceOpacity">0.96</x:Double>
            <x:Double x:Key="ThemeShadowOpacity">0.12</x:Double>

            <!-- Fluent chrome tokens (T12-A). ThemeChromeBrush is the
                 semi-transparent chrome-band tint resolved only while a
                 system backdrop (Mica/acrylic) is installed —
                 WinUiThemeService.Apply rewrites it per palette and flips
                 it to the opaque toolbar brush under high contrast /
                 reduce-transparency. The ThemeRadius* CornerRadius set is
                 static Fluent geometry shared by chrome + control styles. -->
            <SolidColorBrush x:Key="ThemeChromeBrush" Color="#B3FFFFFF"/>
            <CornerRadius x:Key="ThemeRadiusControl">8</CornerRadius>
            <CornerRadius x:Key="ThemeRadiusCard">10</CornerRadius>
            <CornerRadius x:Key="ThemeRadiusPill">12</CornerRadius>


        </ResourceDictionary>
    </Application.Resources>
</Application>

<Page x:Class="Caelum.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Caelum.Pages"
      xmlns:models="using:Caelum.Models"
      xmlns:controls="using:Caelum.Controls"
      Background="{ThemeResource ThemeWorkspaceBrush}">

    <!--
        WinUI port of WPF Pages/HomePage.xaml.
        Mappings: DynamicResource -> ThemeResource; ContextMenu -> per-show
        MenuFlyout (code-behind); Style/DataTriggers -> computed properties on
        HomeTile (TileBackground/TileBorderBrush/TileBorderThickness,
        CheckBadge*/AutomationId) + VisualStateManager on custom button
        templates; WrapPanel ItemsControl -> ItemsRepeater + UniformGridLayout;
        DragDrop.DoDragDrop -> CanDrag/DragStarting; the add tile's
        selection-mode collapse is handled by filtering it out of VisibleTiles.
    -->

    <Page.Resources>
        <Style x:Key="InvisibleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary-style action button (WPF DialogSecondaryButton base).
             T12-C: rebuilt to the T12-A/B convention — hover/press paint a
             StateLayer whose Opacity is interpolated by the generated
             VisualTransitions (brush objects can't animate), plus a subtle
             0.96 press squish. Colors/states are unchanged. -->
        <Style x:Key="SelectionActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ThemeControlBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{ThemeResource ThemeRadiusControl}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RootScale"/>
                            </Border.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0:0:0.12"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                            <Setter Target="RootScale.ScaleX" Value="0.96"/>
                                            <Setter Target="RootScale.ScaleY" Value="0.96"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.55"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="StateLayer" CornerRadius="{ThemeResource ThemeRadiusControl}" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined danger action button (WPF SelectionDangerButtonStyle) —
             same T12 StateLayer + transition pattern; the danger tint stays
             on the BorderBrush/Foreground setters. -->
        <Style x:Key="SelectionDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ThemeControlBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeDangerBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ThemeDangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{ThemeResource ThemeRadiusControl}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RootScale"/>
                            </Border.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0:0:0.12"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                            <Setter Target="RootScale.ScaleX" Value="0.96"/>
                                            <Setter Target="RootScale.ScaleY" Value="0.96"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.55"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="StateLayer" CornerRadius="{ThemeResource ThemeRadiusControl}" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Breadcrumb "Back" pill (T12-C): the NavigateUpButton chrome —
             paper-alt card + hairline + ThemeRadiusCard radius; hover/press
             paint a StateLayer via generated transitions, same convention as
             the T12-A NavButtonStyle but auto-width with content padding. -->
        <Style x:Key="BreadcrumbPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ThemePaperAltBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{ThemeResource ThemeRadiusCard}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RootScale"/>
                            </Border.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0:0:0.12"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                            <Setter Target="RootScale.ScaleX" Value="0.96"/>
                                            <Setter Target="RootScale.ScaleY" Value="0.96"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.55"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="StateLayer" CornerRadius="{ThemeResource ThemeRadiusCard}" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AddTileTemplate" x:DataType="models:HomeTile">
            <Button Style="{StaticResource InvisibleButtonStyle}" Click="AddTile_Click" VerticalAlignment="Top"
                    Tag="{x:Bind}"
                    controls:CursorExtensions.Hand="True"
                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind AutomationId, Mode=OneWay}"
                    PointerEntered="TileButton_PointerEntered" PointerExited="TileButton_PointerExited"
                    Loaded="TileCard_Loaded">
                <!-- T12-C card motion target: TileButton_PointerEntered lifts
                     this transform a couple px; TileCard_Loaded plays the
                     staggered fade+rise entrance and wires the press settle. -->
                <Button.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Button.RenderTransform>
                <Grid x:Name="AddTileContainer" Width="160" Background="Transparent" Margin="20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="AddTileGrid" Grid.Row="0" Width="120" Height="160" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Viewbox Stretch="Uniform" MaxWidth="90" MaxHeight="120" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="90" Height="120">
                                <!-- T13-B: the tile's hover/selection wash now
                                     reaches the dashed art (same TileBackground
                                     binding the file/folder cards ride). -->
                                <Rectangle x:Name="BgRect" Fill="{x:Bind TileBackground, Mode=OneWay}" RadiusX="8" RadiusY="8"/>
                                <Rectangle Stroke="{ThemeResource ThemeAccentBrush}" StrokeThickness="2" StrokeDashArray="6,4" RadiusX="8" RadiusY="8"/>
                                <controls:LucideIcon Kind="Plus" Width="36" Height="36" Stroke="{ThemeResource ThemeAccentBrush}"
                                                     StrokeThickness="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FolderTileTemplate" x:DataType="models:HomeTile">
            <Border x:Name="FolderTileBorder" Margin="20,12" CornerRadius="{ThemeResource ThemeRadiusCard}" Padding="0"
                    Background="{x:Bind TileBackground, Mode=OneWay}"
                    BorderBrush="{x:Bind TileBorderBrush, Mode=OneWay}"
                    BorderThickness="{x:Bind TileBorderThickness, Mode=OneWay}"
                    controls:CursorExtensions.Hand="True"
                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                    Tag="{x:Bind}"
                    ContextRequested="FolderTile_ContextRequested"
                    PointerEntered="TileCard_PointerEntered" PointerExited="TileCard_PointerExited"
                    Loaded="TileCard_Loaded">
                <!-- T12-C card lift target (hover −2px / entrance rise —
                     RenderTransform never disturbs the repeater layout). -->
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid Width="160"
                      Background="Transparent"
                      Tag="{x:Bind}"
                      AllowDrop="True"
                      DragEnter="FolderTile_DragEnter"
                      DragOver="FolderTile_DragOver"
                      DragLeave="FolderTile_DragLeave"
                      Drop="FolderTile_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Style="{StaticResource InvisibleButtonStyle}"
                            Click="FolderTile_Click"
                            Tag="{x:Bind}"
                            HorizontalAlignment="Center"
                            PointerEntered="TileButton_PointerEntered" PointerExited="TileButton_PointerExited">
                        <Grid x:Name="FolderIconGrid" Width="120" Height="160" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Viewbox Stretch="Uniform" MaxWidth="100" MaxHeight="120" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- T14-B: Fluent two-tone folder silhouette.
                                     Back plate + tab ride FolderTabBrush, the
                                     front plate rides FolderBodyBrush (the
                                     user's folder color), and a FolderLineBrush
                                     seam marks the opening. Per-folder Color
                                     personalization still drives all three. -->
                                <Grid Width="96" Height="96">
                                    <Path Width="80" Height="54" Stretch="Fill"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{x:Bind FolderTabBrush, Mode=OneWay}"
                                          Data="M6,54 L6,12 Q6,6 12,6 L32,6 L40,14 L72,14 Q78,14 78,20 L78,54 Z"/>
                                    <Path Width="80" Height="54" Stretch="Fill"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{x:Bind FolderBodyBrush, Mode=OneWay}"
                                          Data="M12,24 L72,24 Q78,24 78,30 L78,48 Q78,54 72,54 L12,54 Q6,54 6,48 L6,30 Q6,24 12,24 Z"/>
                                    <Path Width="80" Height="54" Stretch="Fill"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{x:Bind FolderLineBrush, Mode=OneWay}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M10,21 L74,21"/>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <TextBlock Grid.Row="1" Text="{x:Bind FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="150"
                               FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ThemeForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="2" Text="{x:Bind InfoText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeSubtleForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FileTileTemplate" x:DataType="models:HomeTile">
            <Border x:Name="FileTileBorder" Margin="20,12" CornerRadius="{ThemeResource ThemeRadiusCard}" Padding="0"
                    Background="{x:Bind TileBackground, Mode=OneWay}"
                    BorderBrush="{x:Bind TileBorderBrush, Mode=OneWay}"
                    BorderThickness="{x:Bind TileBorderThickness, Mode=OneWay}"
                    controls:CursorExtensions.Hand="True"
                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                    Tag="{x:Bind}"
                    ContextRequested="FileTile_ContextRequested"
                    PointerEntered="TileCard_PointerEntered" PointerExited="TileCard_PointerExited"
                    Loaded="TileCard_Loaded">
                <!-- T12-C card lift target (hover −2px / entrance rise). -->
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid Width="160" Background="Transparent" Tag="{x:Bind}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Width="24"
                            Height="24"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,10,0"
                            CornerRadius="{ThemeResource ThemeRadiusPill}"
                            BorderThickness="1"
                            IsHitTestVisible="False"
                            Background="{x:Bind CheckBadgeBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind CheckBadgeBorderBrush, Mode=OneWay}"
                            Visibility="{x:Bind CheckBadgeVisibility, Mode=OneWay}">
                        <controls:LucideIcon Kind="Check" Width="12" Height="12"
                                             Stroke="{ThemeResource ThemeSelectionForegroundBrush}"
                                             StrokeThickness="2.4"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="{x:Bind CheckGlyphVisibility, Mode=OneWay}"/>
                    </Border>

                    <Button Grid.Row="0" Style="{StaticResource InvisibleButtonStyle}"
                            Click="FileTile_Click" HorizontalAlignment="Center"
                            Tag="{x:Bind}"
                            CanDrag="True"
                            DragStarting="FileTile_DragStarting"
                            DropCompleted="FileTile_DropCompleted"
                            PointerEntered="TileButton_PointerEntered" PointerExited="TileButton_PointerExited">
                        <Grid x:Name="IconGrid" Width="120" Height="160" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Viewbox Stretch="Uniform" MaxWidth="90" MaxHeight="120" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- T14-B: Fluent document card — a paper sheet
                                     with a dog-eared top-right corner (the fold
                                     flap sits in SurfaceAlt over the BorderBrush
                                     hairline), subtle content lines, and a small
                                     accent PDF pill. Replaces the accent-spine /
                                     margin-strip art. -->
                                <Grid Width="90" Height="120">
                                    <Path Width="72" Height="94" Stretch="Fill"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{ThemeResource ThemePaperBrush}"
                                          Stroke="{ThemeResource ThemeBorderBrush}" StrokeThickness="1"
                                          Data="M0.5,7.5 Q0.5,0.5 7.5,0.5 L58,0.5 L71.5,14 L71.5,86.5 Q71.5,93.5 64.5,93.5 L7.5,93.5 Q0.5,93.5 0.5,86.5 Z"/>
                                    <Path Width="72" Height="94" Stretch="Fill"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{ThemeResource ThemeSurfaceAltBrush}"
                                          Stroke="{ThemeResource ThemeBorderBrush}" StrokeThickness="1"
                                          Data="M58,0.5 L71.5,14 L58,14 Z"/>
                                    <Grid Width="72" Height="94" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Margin="12,32,12,0">
                                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Opacity="0.28"
                                                       Fill="{ThemeResource ThemeSubtleForegroundBrush}"/>
                                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Opacity="0.28" Width="34"
                                                       HorizontalAlignment="Left" Margin="0,7,0,0"
                                                       Fill="{ThemeResource ThemeSubtleForegroundBrush}"/>
                                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Opacity="0.28" Width="40"
                                                       HorizontalAlignment="Left" Margin="0,7,0,0"
                                                       Fill="{ThemeResource ThemeSubtleForegroundBrush}"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                                Padding="8,1" CornerRadius="{ThemeResource ThemeRadiusPill}"
                                                Background="{ThemeResource ThemeAccentBrush}">
                                            <TextBlock Text="PDF" FontSize="9" FontWeight="Bold"
                                                       Foreground="{ThemeResource ThemeSelectionForegroundBrush}"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <TextBlock Grid.Row="1" Text="{x:Bind FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="150"
                               FontSize="13" Foreground="{ThemeResource ThemeForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"
                               ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}"/>

                    <TextBlock Grid.Row="2" Text="{x:Bind InfoText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeSubtleForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <local:HomeTileTemplateSelector x:Key="HomeTileTemplateSelector"
                                        AddTileTemplate="{StaticResource AddTileTemplate}"
                                        FolderTileTemplate="{StaticResource FolderTileTemplate}"
                                        FileTileTemplate="{StaticResource FileTileTemplate}"/>
    </Page.Resources>

    <Grid AllowDrop="True"
          DragOver="HomePage_DragOver"
          Drop="HomePage_Drop"
          DragLeave="HomePage_DragLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="HomeScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="HomeScrollViewer"
                      PointerWheelChanged="HomeScrollViewer_PointerWheelChanged">
            <StackPanel>
                <!-- T14-B: the stray HomeMarginRail accent strip is gone;
                     the header keeps its old visual left inset (24 page
                     margin + 3 rail + 14 gap = 41). -->
                <StackPanel Margin="41,24,24,6">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,14"
                                Visibility="{x:Bind BreadcrumbBarVisibility, Mode=OneWay}">
                        <Button Click="NavigateUpButton_Click"
                                Style="{StaticResource BreadcrumbPillButtonStyle}"
                                controls:CursorExtensions.Hand="True"
                                Margin="0,0,10,0"
                                AutomationProperties.AutomationId="NavigateUpButton"
                                AutomationProperties.Name="Back">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Kind="ArrowLeft" Width="13" Height="13" Stroke="{ThemeResource ThemeForegroundBrush}" StrokeThickness="2" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind NavigateUpText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ThemeForegroundBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind FolderBreadcrumb, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeSubtleForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="FolderBreadcrumb"/>
                    </StackPanel>
                    <TextBlock x:Name="HomeTitleTextBlock" Style="{ThemeResource TitleTextBlockStyle}"
                               Foreground="{ThemeResource ThemeForegroundBrush}"
                               AutomationProperties.AutomationId="HomeTitleTextBlock"/>
                    <TextBlock x:Name="HomeSubtitleTextBlock" Style="{ThemeResource BodyTextBlockStyle}" Margin="0,6,0,0"
                               Foreground="{ThemeResource ThemeSubtleForegroundBrush}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="HomeSubtitleTextBlock"/>
                </StackPanel>
                <ItemsRepeater x:Name="TilesRepeater"
                              ItemsSource="{x:Bind VisibleTiles, Mode=OneWay}"
                              ItemTemplate="{StaticResource HomeTileTemplateSelector}"
                              Margin="12,4,12,12"
                              Visibility="{x:Bind TilesRepeaterVisibility, Mode=OneWay}"
                              AutomationProperties.AutomationId="TilesGrid">
                    <ItemsRepeater.Layout>
                        <!-- T14-B: explicit slot size is load-bearing.
                             UniformGridLayout caches item 0's DesiredSize as
                             the effective cell for EVERY element; the add tile
                             desired 200x184, so folder/file cards were arranged
                             into a 160x160 box after their 20,12 margin and the
                             two label rows (icon+title+info ≈204 DIP tall)
                             rendered below the element bounds — populated but
                             clipped. MinItemWidth/Height replace the first-item
                             measurement entirely and also keep slots stable
                             when selection mode removes the add tile from
                             index 0. -->
                        <UniformGridLayout Orientation="Horizontal" ItemsJustification="Start"
                                           MinRowSpacing="0" MinColumnSpacing="0"
                                           MinItemWidth="200" MinItemHeight="230"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!-- T13-B: Fluent empty state — icon disc + title + hint +
                     contextual CTA. Library-empty offers the same "open or
                     create" flyout the add tile hosts; search-empty offers a
                     localized title ("No matches for 'x'") + Clear search.
                     Both icon and copy are data-bound so the panel swaps
                     variants without a template. -->
                <StackPanel x:Name="HomeEmptyState"
                            HorizontalAlignment="Center"
                            Margin="0,64,0,48"
                            Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}"
                            AutomationProperties.AutomationId="HomeEmptyState"
                            AutomationProperties.Name="{x:Bind EmptyStateTitle, Mode=OneWay}">
                    <Border Width="56" Height="56" CornerRadius="28"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource ThemeControlBrush}"
                            BorderBrush="{ThemeResource ThemeBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <controls:LucideIcon Kind="FolderOpen" Width="24" Height="24"
                                                 Stroke="{ThemeResource ThemeSubtleForegroundBrush}"
                                                 Visibility="{x:Bind EmptyStateLibraryIconVisibility, Mode=OneWay}"/>
                            <controls:LucideIcon Kind="Search" Width="24" Height="24"
                                                 Stroke="{ThemeResource ThemeSubtleForegroundBrush}"
                                                 Visibility="{x:Bind EmptyStateSearchIconVisibility, Mode=OneWay}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind EmptyStateTitle, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource ThemeForegroundBrush}"
                               TextAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="{x:Bind EmptyStateHint, Mode=OneWay}"
                               FontSize="13" MaxWidth="360"
                               Foreground="{ThemeResource ThemeSubtleForegroundBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="EmptyStateActionButton"
                                Click="EmptyStateAction_Click"
                                controls:CursorExtensions.Hand="True"
                                Style="{ThemeResource AccentButtonStyle}"
                                Content="{x:Bind EmptyStateActionText, Mode=OneWay}"
                                Visibility="{x:Bind EmptyStateActionVisibility, Mode=OneWay}"
                                AutomationProperties.AutomationId="HomeEmptyStateAction"/>
                        <Button x:Name="EmptyStateClearButton"
                                Click="EmptyStateClearSearch_Click"
                                controls:CursorExtensions.Hand="True"
                                Content="{x:Bind EmptyStateClearText, Mode=OneWay}"
                                Visibility="{x:Bind EmptyStateClearVisibility, Mode=OneWay}"
                                AutomationProperties.AutomationId="HomeEmptyStateClearSearch"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- T12-C: the tint now lives on an inner translucent layer so the
             page reads through the Fluent drop affordance (opaque again under
             reduce-transparency via SetDragDropOverlayVisible); the outer
             Border keeps the id + ink hairline + pill radius and fades in
             on DragOver. -->
        <Border x:Name="DragDropOverlay"
                Grid.Row="0"
                BorderBrush="{ThemeResource ThemeInkBrush}"
                BorderThickness="2"
                CornerRadius="{ThemeResource ThemeRadiusPill}"
                Margin="24"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                AutomationProperties.AutomationId="DragDropOverlay">
            <Grid>
                <Border x:Name="DragDropOverlayTint"
                        Background="{ThemeResource ThemeSelectionBrush}"
                        CornerRadius="{ThemeResource ThemeRadiusCard}"
                        Opacity="0.6"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85">
                    <controls:LucideIcon Kind="Import" Width="38" Height="38" Stroke="{ThemeResource ThemeInkBrush}" StrokeThickness="1.8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DragDropOverlayText" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ThemeInkBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"
                               AutomationProperties.AutomationId="DragDropOverlayText"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- T12-C: the selection bar is now a floating Fluent card (surface
             + hairline + pill radius + ThemeShadow), matching the T12-B
             toolbar/sidebar treatment; entering selection mode plays a short
             fade+rise from code (PlaySelectionBarEntrance). -->
        <Border x:Name="SelectionActionBar"
                Grid.Row="1"
                Margin="24,0,24,24"
                Padding="18,16"
                Background="{ThemeResource ThemeSurfaceBrush}"
                BorderBrush="{ThemeResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ThemeRadiusPill}"
                Translation="0,0,8"
                Visibility="{x:Bind SelectionBarVisibility, Mode=OneWay}"
                AutomationProperties.AutomationId="SelectionActionBar">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SelectionBarRiseTransform" X="0" Y="0"/>
            </Border.RenderTransform>
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind SelectionSummary, Mode=OneWay}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource ThemeForegroundBrush}"
                               AutomationProperties.AutomationId="SelectionSummary"/>
                    <TextBlock Text="{x:Bind SelectionHint, Mode=OneWay}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{ThemeResource ThemeSubtleForegroundBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="SelectionHint"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="SelectAllSelectionButton"
                            Click="SelectAllSelectionButton_Click"
                            controls:CursorExtensions.Hand="True"
                            Style="{StaticResource SelectionActionButtonStyle}"
                            Content="{x:Bind SelectionSelectAllText, Mode=OneWay}"
                            IsEnabled="{x:Bind CanSelectAllTiles, Mode=OneWay}"
                            AutomationProperties.AutomationId="SelectAllSelectionButton"/>
                    <Button x:Name="ClearSelectionButton"
                            Click="ClearSelectionButton_Click"
                            controls:CursorExtensions.Hand="True"
                            Style="{StaticResource SelectionActionButtonStyle}"
                            Content="{x:Bind SelectionClearText, Mode=OneWay}"
                            IsEnabled="{x:Bind HasSelectedTiles, Mode=OneWay}"
                            AutomationProperties.AutomationId="ClearSelectionButton"/>
                    <Button x:Name="MoveSelectionButton"
                            Click="MoveSelectionButton_Click"
                            controls:CursorExtensions.Hand="True"
                            Style="{StaticResource SelectionActionButtonStyle}"
                            Content="{x:Bind SelectionMoveText, Mode=OneWay}"
                            IsEnabled="{x:Bind CanChooseMoveTarget, Mode=OneWay}"
                            AutomationProperties.AutomationId="MoveSelectionButton"/>
                    <Button x:Name="RemoveSelectionButton"
                            Click="RemoveSelectionButton_Click"
                            controls:CursorExtensions.Hand="True"
                            Style="{StaticResource SelectionDangerButtonStyle}"
                            Content="{x:Bind SelectionRemoveText, Mode=OneWay}"
                            IsEnabled="{x:Bind HasSelectedTiles, Mode=OneWay}"
                            AutomationProperties.AutomationId="RemoveSelectionButton"/>
                    <Button x:Name="DeleteSelectionButton"
                            Click="DeleteSelectionButton_Click"
                            controls:CursorExtensions.Hand="True"
                            Style="{StaticResource SelectionDangerButtonStyle}"
                            Content="{x:Bind SelectionDeleteText, Mode=OneWay}"
                            IsEnabled="{x:Bind HasSelectedTiles, Mode=OneWay}"
                            AutomationProperties.AutomationId="DeleteSelectionButton"/>
                    <Button x:Name="DoneSelectionButton"
                            Click="DoneSelectionButton_Click"
                            controls:CursorExtensions.Hand="True"
                            Style="{StaticResource SelectionActionButtonStyle}"
                            Content="{x:Bind SelectionDoneText, Mode=OneWay}"
                            Margin="0"
                            AutomationProperties.AutomationId="DoneSelectionButton"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

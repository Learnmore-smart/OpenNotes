<Page
    x:Class="Caelum.Pages.HomePlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Stub home content for the V6 shell. Task 5 replaces this page with the
        real library HomePage port; the shell only needs a navigable tab
        content element for now.
    -->
    <Grid Background="{ThemeResource ThemeWorkspaceBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE80F;" FontSize="32" Foreground="{ThemeResource ThemeAccentBrush}"
                      HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="PlaceholderTitle" Text="Home" FontSize="20" FontWeight="SemiBold"
                       Foreground="{ThemeResource ThemeForegroundBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="The library arrives with the Task 5 HomePage port."
                       FontSize="12" Foreground="{ThemeResource ThemeSubtleForegroundBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Page>

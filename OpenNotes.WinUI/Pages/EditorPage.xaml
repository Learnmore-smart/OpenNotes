<Page x:Class="Caelum.Pages.EditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Caelum.Controls"
      xmlns:pages="using:Caelum.Pages"
      Background="{ThemeResource ThemeWindowBrush}"
      SizeChanged="EditorPage_SizeChanged"
      PreviewKeyDown="EditorPage_PreviewKeyDown">

    <!--
        V6 WinUI port of WPF Pages/EditorPage.xaml, Task 6 scope:
        document layout, scroll/zoom, toolbar chrome, three-tab sidebar,
        search panel and the loading overlay.

        Deferred ports are marked T7 (ink/pen/ruler/eraser/shape/laser),
        T8 (text/select/sticky annotations + search-bound highlights),
        T9 (page ops: insert-gap affordances, delete buttons, thumbnail
        drag-reorder, save/version pipeline).
        The WPF SelectablePdfContainer / WindowsFormsHost surface is not
        ported: WinForms cannot be hosted in WinUI.
    -->

    <Page.Resources>
        <!-- Toolbar button (WPF ToolbarButtonStyle) — T12-A Fluent motion:
             hover/press paint a StateLayer whose Opacity is interpolated by
             the generated VisualTransitions (brush objects can't animate),
             and press adds a subtle 0.96 squish on the root scale. -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="{ThemeResource ThemeRadiusControl}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RootScale"/>
                            </Border.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0:0:0.12"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                            <Setter Target="RootScale.ScaleX" Value="0.96"/>
                                            <Setter Target="RootScale.ScaleY" Value="0.96"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.55"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="StateLayer" CornerRadius="{ThemeResource ThemeRadiusControl}" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Undo/redo: icon colour reflects enabled state (WPF UndoRedoButtonStyle). -->
        <Style x:Key="UndoRedoButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
        </Style>

        <!-- Toolbar toggle button (WPF ToolbarToggleButtonStyle) with the
             bottom accent bar on Checked. T12-A Fluent treatment: the
             selection tint lives on a CheckedLayer that fades in, and the
             ActiveBar accent underline grows from 60% width with an opacity
             fade (keep the ActiveBar element name — UIA/tests probe it).
             IMPORTANT — WinUI ToggleButton.ChangeVisualState issues ONE
             GoToState with combined names (CheckedPointerOver/
             CheckedPressed/CheckedDisabled while checked) in the single
             CommonStates group, NOT the WPF two-dimension model where
             CommonStates and CheckStates update independently. Every
             combined state must therefore carry its full visuals inline:
             a bare Checked in a second group would leave the Pressed
             layer + squish stuck for the whole checked lifetime and give
             checked toggles no hover/press/disabled feedback. The state
             list mirrors the stock template (12 CommonStates entries);
             transitions still do the animated reveals. -->
        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="ToggleChrome" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ToggleChromeScale"/>
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="Checked" GeneratedDuration="0:0:0.15"/>
                                        <VisualTransition To="CheckedPointerOver" GeneratedDuration="0:0:0.15"/>
                                        <VisualTransition To="CheckedPressed" GeneratedDuration="0:0:0.15"/>
                                        <VisualTransition To="CheckedDisabled" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="Indeterminate" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="IndeterminatePointerOver" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="IndeterminatePressed" GeneratedDuration="0:0:0.06"/>
                                        <VisualTransition To="IndeterminateDisabled" GeneratedDuration="0:0:0.12"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                            <Setter Target="ToggleChromeScale.ScaleX" Value="0.96"/>
                                            <Setter Target="ToggleChromeScale.ScaleY" Value="0.96"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ToggleChrome.Opacity" Value="0.55"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <!-- Checked visuals ride inside EVERY combined checked
                                         state so checking/pressing/hovering/disabling a
                                         checked toggle never drops the selection layer or
                                         the ActiveBar. -->
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedLayer.Opacity" Value="1"/>
                                            <Setter Target="ActiveBar.Opacity" Value="1"/>
                                            <Setter Target="ActiveBarScale.ScaleX" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedLayer.Opacity" Value="1"/>
                                            <Setter Target="ActiveBar.Opacity" Value="1"/>
                                            <Setter Target="ActiveBarScale.ScaleX" Value="1"/>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedLayer.Opacity" Value="1"/>
                                            <Setter Target="ActiveBar.Opacity" Value="1"/>
                                            <Setter Target="ActiveBarScale.ScaleX" Value="1"/>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                            <Setter Target="ToggleChromeScale.ScaleX" Value="0.96"/>
                                            <Setter Target="ToggleChromeScale.ScaleY" Value="0.96"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedLayer.Opacity" Value="1"/>
                                            <Setter Target="ActiveBar.Opacity" Value="1"/>
                                            <Setter Target="ActiveBarScale.ScaleX" Value="1"/>
                                            <Setter Target="ToggleChrome.Opacity" Value="0.55"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <!-- Three-state names for completeness — the toolbar
                                         toggles are two-state so these are never emitted;
                                         they mirror the unchecked interaction visuals. -->
                                    <VisualState x:Name="Indeterminate"/>
                                    <VisualState x:Name="IndeterminatePointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePressed">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            <Setter Target="StateLayer.Opacity" Value="1"/>
                                            <Setter Target="ToggleChromeScale.ScaleX" Value="0.96"/>
                                            <Setter Target="ToggleChromeScale.ScaleY" Value="0.96"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminateDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="ToggleChrome.Opacity" Value="0.55"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    CornerRadius="{ThemeResource ThemeRadiusControl}"/>
                            <Border x:Name="CheckedLayer" Background="{ThemeResource ThemeSelectionBrush}"
                                    CornerRadius="{ThemeResource ThemeRadiusControl}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="StateLayer" CornerRadius="{ThemeResource ThemeRadiusControl}" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="ActiveBar" Background="{ThemeResource ThemeAccentBrush}" Height="3" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch" CornerRadius="1.5"
                                    Margin="6,0,6,2" Opacity="0" IsHitTestVisible="False"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ActiveBarScale" ScaleX="0.6"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Background" Value="{ThemeResource ThemeMenuSeparatorBrush}"/>
        </Style>

        <!-- Document rail nav button — T12-B Fluent segmented-tab cell.
             Selection state is applied from ApplySidebarButtonState
             (background/border/weight/foreground + the cue inside the
             content), the WinUI replacement for WPF's Tag trigger; the
             icon Stroke binds the button Foreground so the selected cell
             picks up the accent glyph. Hover/press use the same
             StateLayer + generated-transition pattern as the toolbar. -->
        <Style x:Key="DocumentSidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{ThemeResource ThemeRadiusControl}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="NavRootScale"/>
                            </Border.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition To="Normal" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.12"/>
                                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06"/>
                                        <VisualTransition To="Disabled" GeneratedDuration="0:0:0.12"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="NavStateLayer.Background" Value="{ThemeResource ThemeControlHoverBrush}"/>
                                            <Setter Target="NavStateLayer.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="NavStateLayer.Background" Value="{ThemeResource ThemeControlPressedBrush}"/>
                                            <Setter Target="NavStateLayer.Opacity" Value="1"/>
                                            <Setter Target="NavRootScale.ScaleX" Value="0.97"/>
                                            <Setter Target="NavRootScale.ScaleY" Value="0.97"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="NavRoot.Opacity" Value="0.55"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="NavStateLayer" CornerRadius="{ThemeResource ThemeRadiusControl}" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar list items (thumbnails + bookmarks): ListViewItemPresenter
             driven template so native selection/hover visuals stay themed. -->
        <Style x:Key="DocumentSidebarListBoxItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="{ThemeResource ThemeRadiusControl}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ListViewItemPresenter
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Control.IsTemplateFocusTarget="True"
                            Foreground="{TemplateBinding Foreground}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ContentMargin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            MaxHeight="{TemplateBinding MaxHeight}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            CheckMode="Inline"
                            SelectionCheckMarkVisualEnabled="False"
                            PointerOverBackground="{ThemeResource ThemeControlHoverBrush}"
                            PressedBackground="{ThemeResource ThemeControlPressedBrush}"
                            SelectedBackground="{ThemeResource ThemeSelectionBrush}"
                            SelectedForeground="{ThemeResource ThemeForegroundBrush}"
                            SelectedPointerOverBackground="{ThemeResource ThemeSelectionBrush}"
                            SelectedPressedBackground="{ThemeResource ThemeControlPressedBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- T13-A: shared Fluent card chrome for every editor Flyout —
             the stock FlyoutPresenter template has no shadow, so this
             template re-states it with the theme surface/border/card-radius
             tokens plus a ThemeShadow on a 32-DIP z-lift (same elevation
             band as the floating toolbar). Assigned per-flyout via
             ApplyToolFlyoutChrome so MenuFlyout presenters stay stock. -->
        <Style x:Key="EditorFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{ThemeResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource ThemeRadiusCard}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.ZoomMode" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="FlyoutPresenter">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BackgroundSizing="InnerBorderEdge"
                                Translation="0,0,32">
                            <Border.Shadow>
                                <ThemeShadow/>
                            </Border.Shadow>
                            <ScrollViewer x:Name="ScrollViewer"
                                    ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}"
                                    HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                    AutomationProperties.AccessibilityView="Raw">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- T13-A: search hits are added as direct ListViewItem objects
             (Items.Clear/Items.Add — bypassing the container generator), so
             ItemContainerStyle never reaches them; the style is assigned in
             code per item. BasedOn the shared sidebar item chrome keeps the
             rounded hover/selection treatment; tighter padding + a smaller
             type ramp fit the denser result rows. -->
        <Style x:Key="PdfSearchResultItemStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DocumentSidebarListBoxItemStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{ThemeResource ThemeControlBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModernListBox" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeTextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DocumentSidebarListBoxItemStyle}"/>
        </Style>

        <!-- Page thumbnail card (T12-B): rounded card with a hairline that
             flips to the accent brush while its page is current (the model's
             CardBorderBrush follows IsSelected like LabelForeground). The
             image keeps a fixed 132x170 Uniform fit box so every page aspect
             letterboxes inside the card instead of cropping. -->
        <DataTemplate x:Key="SidebarPageItemTemplate" x:DataType="pages:SidebarPageItem">
            <!-- T13-A hover-lift: pointer enter/exit animate this root's
                 RenderTransform −1 DIP and deepen the card's ThemeShadow via
                 the Z channel of Translation (ThumbnailCard_PointerEntered/
                 Exited; both gated on WinUiThemeService.ShouldAnimate and
                 reset in ThumbnailImage_Loaded so recycled rows never carry
                 a stuck lift). -->
            <StackPanel Margin="0,2"
                        PointerEntered="ThumbnailCard_PointerEntered"
                        PointerExited="ThumbnailCard_PointerExited"
                        AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind PageLabel, Mode=OneWay}">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="0"/>
                </StackPanel.RenderTransform>
                <Border x:Name="ThumbnailCardSurface"
                        CornerRadius="{ThemeResource ThemeRadiusCard}"
                        Background="{ThemeResource ThemeSurfaceAltBrush}"
                        BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                        BorderThickness="1" Margin="2" Padding="2" HorizontalAlignment="Center"
                        Translation="0,0,4">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <Image Width="132"
                           Height="170"
                           Stretch="Uniform"
                           Loaded="ThumbnailImage_Loaded"
                           Source="{x:Bind Thumbnail, Mode=OneWay}"/>
                </Border>
                <TextBlock x:Name="PageLabelText"
                           Text="{x:Bind PageLabel, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,2"
                           Foreground="{x:Bind LabelForeground, Mode=OneWay}"
                           FontWeight="{x:Bind LabelFontWeight, Mode=OneWay}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SidebarBookmarkItemTemplate" x:DataType="pages:SidebarBookmarkItem">
            <TextBlock Text="{x:Bind Label, Mode=OneTime}"
                       Foreground="{ThemeResource ThemeForegroundBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- WinUI TreeView applies ItemTemplate to each node's Content; the
             hierarchy itself is built in code (TreeViewNode.Children). -->
        <DataTemplate x:Key="SidebarOutlineItemTemplate">
            <Grid MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Content.Title}"
                           AutomationProperties.AutomationId="{Binding Content.AutomationId}"
                           AutomationProperties.Name="{Binding Content.Title}"
                           Foreground="{ThemeResource ThemeForegroundBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Width="32"
                        Height="32"
                        MinWidth="32"
                        MinHeight="32"
                        Margin="4,0,0,0"
                        Padding="6"
                        Style="{StaticResource ToolbarButtonStyle}"
                        IsTabStop="True"
                        Tag="{Binding Content.PageIndex}"
                        AutomationProperties.AutomationId="{Binding Content.InvokeAutomationId}"
                        AutomationProperties.Name="{Binding Content.PageLabel}"
                        x:Name="OutlineInvokeGlyphButton"
                        Click="OutlineInvokeButton_Click">
                    <Path Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, ElementName=OutlineInvokeGlyphButton}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M3,12 L12,3 M5,3 H12 V10"/>
                </Button>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="EditorRootGrid">
        <!-- PDF Pages Container (full area). ZoomMode=Enabled gives the WPF
             LayoutTransform equivalent: the ScrollViewer scales its content
             and exposes ChangeView(offsetX, offsetY, zoom) so zoom anchoring
             math stays exact. Ctrl+wheel is intercepted in code-behind to
             keep the 0.1 step contract; pinch uses the native zoom. -->
        <ScrollViewer x:Name="PdfScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Background="{ThemeResource ThemeWorkspaceBackdropBrush}"
                      ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="8"
                      ViewChanged="PdfScrollViewer_ViewChanged">
            <!-- PointerWheelChanged lives on the content, not the
                 ScrollViewer: bubbling reaches the pages before the
                 ScrollViewer element, so marking Ctrl+wheel handled here
                 suppresses the native zoom step and keeps the 0.1 contract. -->
            <controls:UiaStackPanel x:Name="PagesContainer" Margin="32,20,32,32" HorizontalAlignment="Center"
                        Background="{ThemeResource ThemePaperBrush}"
                        PointerWheelChanged="PagesContainer_PointerWheelChanged"
                        AutomationProperties.AutomationId="PagesContainer">
                <!-- T12-A: sidebar collapse/expand writes the final Margin
                     instantly (the pages-margin-left probe reads it), then
                     eases this X offset back to zero so the page stack
                     appears to slide instead of snapping. -->
                <controls:UiaStackPanel.RenderTransform>
                    <TranslateTransform x:Name="PagesShiftTransform" X="0"/>
                </controls:UiaStackPanel.RenderTransform>
            </controls:UiaStackPanel>
        </ScrollViewer>

        <!-- T7: on-screen ruler overlay. Viewport-anchored (never moves with
             the document) and spans across pages. -->
        <Canvas x:Name="RulerOverlayCanvas"/>

        <!-- Floating Toolbar -->
        <Border x:Name="ToolbarBorder" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,12,0,0" Padding="8,4" CornerRadius="{ThemeResource ThemeRadiusPill}"
                Background="{ThemeResource ThemeToolbarBrush}"
                BorderBrush="{ThemeResource ThemeBorderBrush}"
                BorderThickness="1" Translation="0,0,16">
            <!-- T12-A: one-time entrance slide (see PlayToolbarEntrance);
                 stays at the identity transform afterwards. -->
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToolbarEntranceTransform" X="0" Y="0"/>
            </Border.RenderTransform>
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid x:Name="ToolbarOverlayGrid">
                <ScrollViewer x:Name="ToolbarItemsScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Hidden"
                              AutomationProperties.AutomationId="Editor.ToolbarOverflow">
                    <StackPanel Orientation="Horizontal" Height="42">
                        <!-- Undo (state-driven: UpdateUndoRedoButtons enables when the ledger has actions) -->
                        <Button x:Name="UndoButton" Click="UndoButton_Click"
                                Style="{StaticResource UndoRedoButtonStyle}"
                                Width="36" Height="36" Margin="1,0" IsEnabled="False"
                                AutomationProperties.AutomationId="Editor.UndoButton">
                            <controls:LucideIcon Kind="Undo2" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=UndoButton}"/>
                        </Button>

                        <!-- Redo (state-driven via UpdateUndoRedoButtons) -->
                        <Button x:Name="RedoButton" Click="RedoButton_Click"
                                Style="{StaticResource UndoRedoButtonStyle}"
                                Width="36" Height="36" Margin="1,0" IsEnabled="False"
                                AutomationProperties.AutomationId="Editor.RedoButton">
                            <controls:LucideIcon Kind="Redo2" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=RedoButton}"/>
                        </Button>

                        <!-- Separator -->
                        <Border Style="{StaticResource ToolbarSeparatorStyle}"/>

                        <!-- Pen (T7: toggle-visual only) -->
                        <ToggleButton x:Name="PenToolButton" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.PenToolButton">
                            <Grid Width="22" Height="22">
                                <controls:LucideIcon x:Name="PenIcon" Kind="PenLine" Width="18" Height="18"
                                                     Stroke="{Binding Foreground, ElementName=PenToolButton}"/>
                                <Border x:Name="PenColorIndicator"
                                        Width="12" Height="2.5"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="1.25"
                                        Background="#000000"/>
                            </Grid>
                        </ToggleButton>

                        <!-- Highlighter (T7) -->
                        <ToggleButton x:Name="HighlighterToolButton" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.HighlighterToolButton">
                            <Grid Width="22" Height="22">
                                <controls:LucideIcon x:Name="HighlighterIcon" Kind="Highlighter" Width="18" Height="18"
                                                     Stroke="{Binding Foreground, ElementName=HighlighterToolButton}"/>
                                <Border x:Name="HighlighterColorIndicator"
                                        Width="12" Height="2.5"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="1.25"
                                        Background="#8CFFFF00"/>
                            </Grid>
                        </ToggleButton>

                        <!-- Study mode: freehand opaque mask (T7). The
                             "HiddenInkToolButton" AutomationId has no Editor.
                             prefix in the pinned WPF contract — keep it. -->
                        <ToggleButton x:Name="HiddenInkToolButton" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="HiddenInkToolButton">
                            <controls:LucideIcon x:Name="HiddenInkIcon" Kind="HiddenInkReveal" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=HiddenInkToolButton}"/>
                        </ToggleButton>

                        <!-- Sticky note (T8) -->
                        <ToggleButton x:Name="StickyNoteToolButton" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.StickyNoteToolButton">
                            <controls:LucideIcon Kind="StickyNote" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=StickyNoteToolButton}"/>
                        </ToggleButton>

                        <!-- Eraser (T7) -->
                        <ToggleButton x:Name="EraserToolButton" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.EraserToolButton">
                            <controls:LucideIcon Kind="Eraser" x:Name="EraserIcon" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=EraserToolButton}"/>
                        </ToggleButton>

                        <!-- Shape (T7) -->
                        <ToggleButton x:Name="ShapeToolButton" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.ShapeToolButton">
                            <controls:LucideIcon x:Name="ShapeIcon" Kind="Shapes" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=ShapeToolButton}"/>
                        </ToggleButton>

                        <!-- Laser pointer (T7) -->
                        <ToggleButton x:Name="LaserToolButton" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.LaserToolButton">
                            <controls:LucideIcon x:Name="LaserIcon" Kind="Laser" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=LaserToolButton}"/>
                        </ToggleButton>

                        <!-- On-screen ruler overlay toggle (T7 Phase B).
                             WPF parity: NOT a ToolType — stays active
                             alongside the current tool. -->
                        <ToggleButton x:Name="RulerToolButton" Click="RulerToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.RulerToolButton">
                            <controls:LucideIcon x:Name="RulerIcon" Kind="Ruler" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=RulerToolButton}"/>
                        </ToggleButton>

                        <!-- Reserve the toolbar midpoint for the centered page navigator.
                             Coupled to CenteredPageJumpHost's auto-sized width (~148 DIP
                             at ≤3-digit page counts): the reserve must never be narrower
                             or neighbouring buttons slide under the overlay pill. -->
                        <Border x:Name="PageJumpReservedSpace"
                                Width="152"
                                Height="36"
                                Margin="1,0"
                                Background="Transparent"
                                IsHitTestVisible="False"/>

                        <!-- Select (T8) -->
                        <ToggleButton x:Name="SelectToolButton" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.SelectToolButton">
                            <controls:LucideIcon x:Name="SelectIcon" Kind="MousePointer2" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=SelectToolButton}"/>
                        </ToggleButton>

                        <Border Style="{StaticResource ToolbarSeparatorStyle}"/>

                        <!-- Text (T8) -->
                        <ToggleButton x:Name="TextToolButton" Click="ToolButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.TextToolButton">
                            <controls:LucideIcon Kind="Type" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=TextToolButton}"/>
                        </ToggleButton>

                        <!-- Save (T9 Phase A: wired to the shared save task) -->
                        <Button x:Name="SavePdfButton" Click="SavePdf_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="36" Height="36" Margin="1,0"
                                AutomationProperties.AutomationId="Editor.SavePdfButton">
                            <controls:LucideIcon Kind="Save" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=SavePdfButton}"/>
                        </Button>

                        <!-- Version History (T9-B: wired to the restore flyout) -->
                        <Button x:Name="VersionHistoryButton" Click="VersionHistory_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="36" Height="36" Margin="1,0"
                                AutomationProperties.AutomationId="Editor.VersionHistoryButton">
                            <controls:LucideIcon Kind="History" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=VersionHistoryButton}"/>
                        </Button>

                        <!-- Separator -->
                        <Border Style="{StaticResource ToolbarSeparatorStyle}"/>

                        <!-- Pen-only drawing / palm rejection (T7: visual toggle) -->
                        <ToggleButton x:Name="PenOnlyButton" Click="PenOnlyButton_Click"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Width="36" Height="36" Margin="1,0"
                                      AutomationProperties.AutomationId="Editor.PenOnlyButton">
                            <controls:LucideIcon x:Name="PenOnlyIcon" Kind="PenLine" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=PenOnlyButton}"/>
                        </ToggleButton>

                        <!-- Segmented zoom pill (T12-B): one rounded shell with
                             hairline separators between − / label / + so the
                             cluster reads as a single Fluent control. All
                             x:Names, AutomationIds and handlers are unchanged —
                             ZoomLabel still taps open ZoomTextBox editing. -->
                        <Border x:Name="ZoomSegmentPill"
                                Height="36"
                                Margin="1,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ThemeSurfaceAltBrush}"
                                BorderBrush="{ThemeResource ThemeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ThemeRadiusCard}">
                            <StackPanel Orientation="Horizontal" Margin="1,0">
                                <!-- Zoom Out -->
                                <Button x:Name="ZoomOutButton" Click="ZoomOutButton_Click"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Width="34" Height="34"
                                        AutomationProperties.AutomationId="Editor.ZoomOutButton">
                                    <controls:LucideIcon Kind="Minus" Width="18" Height="18"
                                                         Stroke="{Binding Foreground, ElementName=ZoomOutButton}"/>
                                </Button>
                                <Border Width="1" Margin="0,7"
                                        Background="{ThemeResource ThemeMenuSeparatorBrush}"/>

                                <!-- Zoom Percentage (click to edit) -->
                                <Grid Width="46" Height="34">
                                    <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12" Foreground="{ThemeResource ThemeForegroundBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                               Tapped="ZoomLabel_Tapped"
                                               AutomationProperties.AutomationId="Editor.ZoomLabel"/>
                                    <TextBox x:Name="ZoomTextBox" FontSize="12" Foreground="{ThemeResource ThemeForegroundBrush}" Background="{ThemeResource ThemePaperAltBrush}"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             Width="42" Height="22" TextAlignment="Center" Padding="2,1"
                                             BorderThickness="1" BorderBrush="{ThemeResource ThemeFocusBrush}"
                                             Visibility="Collapsed"
                                             KeyDown="ZoomTextBox_KeyDown"
                                             LostFocus="ZoomTextBox_LostFocus"
                                             AutomationProperties.AutomationId="Editor.ZoomInput"/>
                                </Grid>
                                <Border Width="1" Margin="0,7"
                                        Background="{ThemeResource ThemeMenuSeparatorBrush}"/>

                                <!-- Zoom In -->
                                <Button x:Name="ZoomInButton" Click="ZoomInButton_Click"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Width="34" Height="34"
                                        AutomationProperties.AutomationId="Editor.ZoomInButton">
                                    <controls:LucideIcon Kind="Plus" Width="18" Height="18"
                                                         Stroke="{Binding Foreground, ElementName=ZoomInButton}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button x:Name="RotatePageButton" Click="RotateCurrentPage_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="36" Height="36" Margin="1,0"
                                AutomationProperties.AutomationId="Editor.RotatePageButton">
                            <controls:LucideIcon Kind="RotateCcw" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, ElementName=RotatePageButton}"/>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- The editable, one-based page navigator stays centered even
                     when toolbar actions are added, removed, or scrolled. -->
                <Border x:Name="CenteredPageJumpHost"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinHeight="34"
                        Canvas.ZIndex="1"
                        Background="{ThemeResource ThemeSurfaceAltBrush}"
                        BorderBrush="{ThemeResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ThemeRadiusCard}">
                    <Grid>
                        <controls:UiaGrid x:Name="PageJumpGroup"
                              Margin="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              AutomationProperties.AutomationId="Editor.PageJumpGroup">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousPageButton"
                                    Grid.Column="0"
                                    Width="32" Height="32" MinWidth="32" MinHeight="32"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="PreviousPageButton_Click"
                                    AutomationProperties.AutomationId="Editor.PreviousPageButton">
                                <controls:LucideIcon Kind="ChevronLeft" Width="18" Height="18"
                                                     Stroke="{Binding Foreground, ElementName=PreviousPageButton}"/>
                            </Button>
                            <!-- T12-B: hairline separators make the group read
                                 as a segmented navigator, not a form field. -->
                            <Border Grid.Column="1" Width="1" Margin="0,7"
                                    Background="{ThemeResource ThemeMenuSeparatorBrush}" Opacity="0.75"/>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBox x:Name="PageNumberTextBox"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Foreground="{ThemeResource ThemeForegroundBrush}"
                                         Background="Transparent"
                                         BorderBrush="Transparent"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         Width="36"
                                         Height="32"
                                         MinHeight="32"
                                         Text="1"
                                         TextAlignment="Center"
                                         Padding="2,0"
                                         IsTabStop="True"
                                         AutomationProperties.AutomationId="Editor.PageJump"
                                         GotFocus="PageNumberTextBox_GotFocus"
                                         TextChanged="PageNumberTextBox_TextChanged"
                                         KeyDown="PageNumberTextBox_KeyDown"
                                         LostFocus="PageNumberTextBox_LostFocus"/>
                                <TextBlock x:Name="PageCountText"
                                           Text="/ 0"
                                           MinWidth="36"
                                           Margin="2,0"
                                           FontSize="13"
                                           Foreground="{ThemeResource ThemeSubtleTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Margin="0,7"
                                    Background="{ThemeResource ThemeMenuSeparatorBrush}" Opacity="0.75"/>
                            <Button x:Name="NextPageButton"
                                    Grid.Column="4"
                                    Width="32" Height="32" MinWidth="32" MinHeight="32"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="NextPageButton_Click"
                                    AutomationProperties.AutomationId="Editor.NextPageButton">
                                <controls:LucideIcon Kind="ChevronRight" Width="18" Height="18"
                                                     Stroke="{Binding Foreground, ElementName=NextPageButton}"/>
                            </Button>
                        </controls:UiaGrid>
                        <TextBlock x:Name="PageNumberLabel"
                                   Text="0"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Custom document navigation rail. It remains an overlay so the PDF
             canvas keeps its scroll/zoom geometry. The three command buttons
             are ordinary invoke peers; content visibility is owned by
             SetSidebarTab. -->
        <controls:UiaContentControl x:Name="DocumentSidebar"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Margin="12,70,0,12"
                Width="184"
                Canvas.ZIndex="20"
                AutomationProperties.AutomationId="DocumentSidebar">
            <!-- T12-B: one coherent Fluent surface — the same surface brush
                 family as the floating toolbar, a uniform hairline, the app
                 pill radius and a low ThemeShadow so the panel floats over
                 the workspace instead of reading as a flat colored block. -->
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource ThemeSurfaceBrush}"
                    BorderBrush="{ThemeResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ThemeRadiusPill}"
                    Translation="0,0,8">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="SidebarHeaderGrid" Grid.Row="0" Margin="8,8,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SidebarTitleLabel"
                               Grid.Column="0"
                               Text=""
                               Foreground="{ThemeResource ThemeForegroundBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="SidebarCollapseButton"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            MinHeight="32"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="SidebarCollapseButton_Click"
                            AutomationProperties.AutomationId="Editor.Sidebar.Collapse">
                        <controls:LucideIcon x:Name="SidebarCollapseIcon" Kind="PanelLeftClose"
                                             Width="18" Height="18"
                                             Stroke="{Binding Foreground, ElementName=SidebarCollapseButton}"/>
                    </Button>
                </Grid>

                <!-- SidebarNavBar.Visibility is updated by SetSidebarCollapsed
                     so collapsed mode leaves only the 32-DIP expand control.
                     T12-B: one segmented selector — icon-only cells (the
                     truncated "Bookma…" labels are gone; the header title
                     names the active tab and each cell carries a localized
                     tooltip + AutomationProperties.Name). The named label
                     elements stay collapsed but keep receiving localized
                     text for the metadata contract. -->
                <Grid x:Name="SidebarNavBar"
                            Grid.Row="1"
                            Margin="8,4,8,8">
                    <Border Background="{ThemeResource ThemeSurfaceAltBrush}"
                            BorderBrush="{ThemeResource ThemeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ThemeRadiusControl}"
                            Padding="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SidebarPagesButton"
                                    Grid.Column="0"
                                    Style="{StaticResource DocumentSidebarNavButtonStyle}"
                                    Click="SidebarPagesButton_Click"
                                    AutomationProperties.AutomationId="Editor.Sidebar.Pages">
                                <StackPanel HorizontalAlignment="Center">
                                    <controls:LucideIcon Kind="Files" Width="18" Height="18"
                                                         Stroke="{Binding Foreground, ElementName=SidebarPagesButton}"/>
                                    <TextBlock x:Name="SidebarPagesLabel" Visibility="Collapsed" Margin="0,3,0,0" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="PagesNavSelectionCue" Height="3" Margin="7,3,7,0" CornerRadius="2"
                                            Background="{ThemeResource ThemeAccentBrush}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SidebarOutlineButton"
                                    Grid.Column="1"
                                    Style="{StaticResource DocumentSidebarNavButtonStyle}"
                                    Click="SidebarOutlineButton_Click"
                                    AutomationProperties.AutomationId="Editor.Sidebar.Outline">
                                <StackPanel HorizontalAlignment="Center">
                                    <controls:LucideIcon Kind="ListTree" Width="18" Height="18"
                                                         Stroke="{Binding Foreground, ElementName=SidebarOutlineButton}"/>
                                    <TextBlock x:Name="SidebarOutlineLabel" Visibility="Collapsed" Margin="0,3,0,0" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="OutlineNavSelectionCue" Height="3" Margin="7,3,7,0" CornerRadius="2"
                                            Background="{ThemeResource ThemeAccentBrush}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SidebarBookmarksButton"
                                    Grid.Column="2"
                                    Style="{StaticResource DocumentSidebarNavButtonStyle}"
                                    Click="SidebarBookmarksButton_Click"
                                    AutomationProperties.AutomationId="Editor.Sidebar.Bookmarks">
                                <StackPanel HorizontalAlignment="Center">
                                    <controls:LucideIcon Kind="Bookmark" Width="18" Height="18"
                                                         Stroke="{Binding Foreground, ElementName=SidebarBookmarksButton}"/>
                                    <TextBlock x:Name="SidebarBookmarksLabel" Visibility="Collapsed" Margin="0,3,0,0" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="BookmarksNavSelectionCue" Height="3" Margin="7,3,7,0" CornerRadius="2"
                                            Background="{ThemeResource ThemeAccentBrush}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="SidebarContentHost" Grid.Row="2" Margin="8,0,8,8">
                    <Grid x:Name="PagesSidebarContent">
                        <ListView x:Name="ThumbnailListBox"
                                 Margin="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource DocumentSidebarListBoxItemStyle}"
                                 ItemTemplate="{StaticResource SidebarPageItemTemplate}"
                                 ItemsSource="{x:Bind SidebarPageItems, Mode=OneWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True"
                                 CanDragItems="False"
                                 CanReorderItems="False"
                                 SelectionChanged="ThumbnailListBox_SelectionChanged"
                                 ContextRequested="ThumbnailListBox_ContextRequested"
                                 AutomationProperties.AutomationId="Editor.Sidebar.Thumbnails"/>
                        <!-- T9: thumbnail drag-reorder drop indicator. -->
                        <Border x:Name="ThumbnailDropIndicator"
                                Height="2"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="{ThemeResource ThemeAccentBrush}"
                                CornerRadius="1"
                                IsHitTestVisible="False"
                                Canvas.ZIndex="10"
                                Visibility="Collapsed"/>
                        <TextBlock x:Name="PagesEmptyState"
                                   Text=""
                                   Foreground="{ThemeResource ThemeSubtleForegroundBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="10"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Visible"/>
                    </Grid>

                    <Grid x:Name="OutlineSidebarContent" Visibility="Collapsed">
                        <!-- The internal TreeViewList surfaces as 'ListControl'
                             in UIA and swallows the TreeView's AutomationId;
                             the UiaGrid wrapper owns the stable probe id. -->
                        <controls:UiaGrid AutomationProperties.AutomationId="Editor.Sidebar.Outline.Tree">
                            <TreeView x:Name="OutlineTreeView"
                                      Margin="0"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      ItemTemplate="{StaticResource SidebarOutlineItemTemplate}"
                                      ItemInvoked="OutlineTreeView_ItemInvoked"
                                      CanReorderItems="False"
                                      CanDragItems="False"/>
                        </controls:UiaGrid>
                        <TextBlock x:Name="OutlineEmptyState"
                                   Text=""
                                   Foreground="{ThemeResource ThemeSubtleForegroundBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="10"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Visible"/>
                    </Grid>

                    <Grid x:Name="BookmarksSidebarContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="BookmarkToggleButton"
                                      Grid.Row="0"
                                      Margin="2,2,2,6"
                                      Height="34"
                                      MinHeight="32"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      IsTabStop="True"
                                      AutomationProperties.AutomationId="Editor.Sidebar.BookmarkToggle"
                                      Click="BookmarkToggleButton_Click"/>
                        <Grid Grid.Row="1">
                            <ListView x:Name="BookmarksListBox"
                                     Margin="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource DocumentSidebarListBoxItemStyle}"
                                     ItemTemplate="{StaticResource SidebarBookmarkItemTemplate}"
                                     ItemsSource="{x:Bind SidebarBookmarkItems, Mode=OneWay}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="BookmarksListBox_SelectionChanged"
                                     ContextRequested="BookmarksListBox_ContextRequested"
                                     AutomationProperties.AutomationId="Editor.Sidebar.Bookmarks.List"/>
                            <TextBlock x:Name="BookmarksEmptyState"
                                       Text=""
                                       Foreground="{ThemeResource ThemeSubtleForegroundBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="10"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Visible"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            </Border>
        </controls:UiaContentControl>

        <!-- Asynchronous full-document search results. -->
        <controls:UiaContentControl x:Name="PdfSearchPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12,70,12,0"
                Width="390"
                Height="330"
                Visibility="Collapsed"
                Canvas.ZIndex="25"
                AutomationProperties.AutomationId="PdfSearchPanel">
            <!-- T13-A: card radius (not the pill chrome radius) + a wider
                 inner pad so the panel reads as a Fluent surface card. -->
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource ThemeSurfaceBrush}"
                    BorderBrush="{ThemeResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ThemeRadiusCard}"
                    Padding="12"
                    Translation="0,0,8">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PdfSearchTextBox" Margin="0,0,8,0" Style="{StaticResource ModernTextBox}"
                             KeyDown="PdfSearchTextBox_KeyDown" TextChanged="PdfSearchTextBox_TextChanged"
                             AutomationProperties.AutomationId="PdfSearchTextBox"/>
                    <Button x:Name="PdfSearchCloseButton" Grid.Column="1" Width="32" Height="32" Click="ClosePdfSearchButton_Click"
                            Style="{StaticResource ToolbarButtonStyle}" Padding="0" MinWidth="32"
                            AutomationProperties.AutomationId="PdfSearchCloseButton">
                        <controls:LucideIcon Kind="X" Width="16" Height="16" Stroke="{Binding Foreground, ElementName=PdfSearchCloseButton}"/>
                    </Button>
                </Grid>
                <!-- Results + the empty/no-results state share row 1 — the
                     overlay hides while hits exist (WPF parity: the status
                     line carries the localized counts). -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <ListView x:Name="PdfSearchResultsListBox" Style="{StaticResource ModernListBox}"
                             SelectionChanged="PdfSearchResultsListBox_SelectionChanged"
                             AutomationProperties.AutomationId="PdfSearchResultsListBox"/>
                    <TextBlock x:Name="PdfSearchEmptyState"
                               Text=""
                               Foreground="{ThemeResource ThemeSubtleForegroundBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="16,24,16,0"
                               VerticalAlignment="Top"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="PdfSearchStatusTextBlock" Grid.Row="2" Margin="2,6,2,0"
                           Foreground="{ThemeResource ThemeSubtleForegroundBrush}" FontSize="11"
                           AutomationProperties.AutomationId="PdfSearchStatus"/>
            </Grid>
            </Border>
        </controls:UiaContentControl>

        <!-- T7: Eraser Size Preview Overlay -->
        <Ellipse x:Name="EraserSizePreviewEllipse"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="{ThemeResource ThemeAccentBrush}" StrokeThickness="1.5" Fill="{ThemeResource ThemeSelectionBrush}"
                 IsHitTestVisible="False" Visibility="Collapsed"
                 Canvas.ZIndex="10"/>

        <!-- UIA-compat probes (Task 5 stub contract): realized but invisible;
             Text carries the document name/path for winui-home-smoke. -->
        <StackPanel Opacity="0" IsHitTestVisible="False" Height="2"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <TextBlock x:Name="EditorPageTitleCompat"
                       AutomationProperties.AutomationId="EditorPageTitle"
                       Height="1"/>
            <TextBlock x:Name="EditorPagePathCompat"
                       AutomationProperties.AutomationId="EditorPagePath"
                       Height="1"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Canvas.ZIndex="40">
            <Border Background="{ThemeResource ThemeWindowBrush}" Opacity="0.28" IsHitTestVisible="True"/>
            <Border CornerRadius="{ThemeResource ThemeRadiusPill}" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource ThemeSurfaceBrush}"
                    BorderBrush="{ThemeResource ThemeBorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ProgressRing IsActive="True" Width="22" Height="22" Margin="0,0,12,0"/>
                    <TextBlock x:Name="LoadingText" FontSize="15" VerticalAlignment="Center" Foreground="{ThemeResource ThemeForegroundBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

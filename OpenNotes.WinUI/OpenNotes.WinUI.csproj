<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Caelum</RootNamespace>
    <AssemblyName>OpenNotes.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embed the app icon into the exe's Win32 resources (same convention as
         OpenNotes.csproj). Without it, shortcuts/taskbar/alt-tab/uninstall all
         render the blank generic icon. -->
    <ApplicationIcon>..\Assets\app-icon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Unpackaged + Windows App SDK self-contained: single .exe folder, no MSIX install -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <Version>6.0.4</Version>
    <AssemblyVersion>6.0.4.0</AssemblyVersion>
    <FileVersion>6.0.4.0</FileVersion>
    <InformationalVersion>6.0.4</InformationalVersion>
    <Authors>Learnmore_smart</Authors>
    <Company>Learnmore_smart</Company>
    <Product>OpenNotes</Product>
    <Description>A paper-like PDF annotation workspace for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <!-- pdfium.dll -> x64\pdfium.dll in output (Core PdfiumRasterizer preloads it from BaseDirectory/x64). -->
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenNotes.Core\OpenNotes.Core.csproj" />
  </ItemGroup>

  <!-- 'dotnet publish' drops the compiled-XAML artifacts for unpackaged WinUI 3
       apps: MarkupCompilePass2/makepri emit *.xbf and the app .pri into
       $(OutDir), but nothing adds them to the publish item group, so the
       published exe crashes at startup with 0xC000027B (stowed XAML resource
       exception). Copy them into $(PublishDir) after Publish, preserving the
       subdirectory layout (Pages/, Controls/) the XAML resource map expects.
       Only the app's own files: Microsoft.*.pri reach the publish output via
       WASDK's own mechanism. The $(PublishDir) guard keeps regular builds
       unaffected. -->
  <Target Name="CopyCompiledXamlToPublish"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_CompiledXaml Include="$(OutDir)**\*.xbf" />
      <!-- Never re-copy xbfs already inside PublishDir — without -o it nests
           under $(OutDir), so the glob would re-glob its own output and grow
           publish\publish\... junk on repeat publishes. -->
      <_CompiledXaml Remove="$(PublishDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_CompiledXaml)"
          DestinationFolder="$(PublishDir)%(_CompiledXaml.RecursiveDir)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
  </Target>

</Project>

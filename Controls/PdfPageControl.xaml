<UserControl
    x:Class="Caelum.Controls.PdfPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <!-- Shadow casting Border (separate from content to maintain hardware accel for ink) -->
        <Border Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.10" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="PageGrid" Background="White">
            <!-- PDF Background -->
            <Image x:Name="PdfImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Task 12.2: swap overlay — same layout slot as PdfImage, sits
                 directly above it. Stages the incoming bitmap for a few frames
                 so the main image can swap underneath without a blank /
                 re-interpolation flash (see SwapPageSource in code-behind). -->
            <Image x:Name="PdfImageOverlay" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" IsHitTestVisible="False"/>

            <!-- Task 19: Image annotation layer (pasted/dropped images).
                 Sits below the ink layer so strokes draw over images; selection
                 happens through SelectionOverlayCanvas, never directly. -->
            <Canvas x:Name="ImageOverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" IsHitTestVisible="False"/>

        <!-- Ink Layer (WPF InkCanvas) -->
        <InkCanvas x:Name="InkCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                   Stylus.IsPressAndHoldEnabled="False"
                   Stylus.IsTapFeedbackEnabled="False"
                   Stylus.IsFlicksEnabled="False" />

        <!-- Shape Drag Preview Layer (dashed outline while dragging a shape) -->
        <Canvas x:Name="ShapePreviewCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" IsHitTestVisible="False"/>

        <!-- Text/Widget Layer -->
        <Canvas x:Name="TextOverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Persistent Text Highlights Layer -->
        <Canvas x:Name="HighlightsCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" IsHitTestVisible="False"/>

        <!-- PDF Text Selection Layer -->
        <Canvas x:Name="PdfTextSelectionCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- Selection Transform Layer (for select/move/scale) -->
        <Canvas x:Name="SelectionOverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" Visibility="Collapsed" IsHitTestVisible="True"/>

        <!-- Study mode: opaque freehand masks. The canvas itself has no
             background, so only a mask path is hit-testable; clicks elsewhere
             still reach the normal editor surface. -->
        <Canvas x:Name="HiddenInkCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="{x:Null}" ClipToBounds="True" IsHitTestVisible="True"/>

        <!-- Eraser Indicator (on its own Canvas so SetLeft/SetTop works) -->
        <Canvas x:Name="EraserCanvas" IsHitTestVisible="False">
            <Ellipse x:Name="EraserIndicator"
                     Width="20"
                     Height="20"
                     Stroke="#0078D4"
                     StrokeThickness="1"
                     Fill="#100078D4"
                     Visibility="Collapsed"
                     IsHitTestVisible="False"/>
        </Canvas>

        <!-- Task 20: laser pointer layer — topmost visual. Ephemeral ink that
             fades away shortly after writing; never enters InkCanvas.Strokes,
             so it is invisible to undo / dirty / save. Hit-testing stays off:
             input is captured by the InkCanvas laser-mode handlers. -->
        <Canvas x:Name="LaserInkCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</UserControl>

